10 REM DWGLTEST : L'INSTRUCTION DWGL -- LA BARRE DE CASES (IOCS 58H)
20 REM CHARGER D'ABORD BASEXT (CALL &BF000) OU LE PILOTE BASEXT-DRV
30 REM LA LIGNE 3 EST LIBEREE PAR XCONSOLE 0,3 ; EFFACER PAR XCLS, JAMAIS
40 REM PAR CLS : SOUS 4 LIGNES, CLS REDESSINE LES LIBELLES FUNCKEY EN LIGNE 3
50 CLS :XCONSOLE 0,3:XCLS
60 LOCATE 0,0:PRINT "1 CROCHETS, 5 CASES";
70 DWGL 0,3,0,"BASIC ,DUMPM ,DRIVER,TRDOS ,SUITE "
80 GOSUB 800
90 XCLS :LOCATE 0,0:PRINT "2 PARENTHESES (TAG 1)";
100 DWGL 0,3,1,"UUENC ,RENUM ,HIST  ,REGIS ,RETOUR"
110 GOSUB 800
120 XCLS :LOCATE 0,0:PRINT "3 COURT, LONG, UNE CASE";
130 DWGL 0,3,0,"A,TROPLONGPOURSIX,C"
140 PRINT :PRINT "ATTENDU [A     ][TROPLO][C     ]";
150 GOSUB 800
160 XCLS :LOCATE 0,0:PRINT "4 TAG &81 : GARDE + PAREN";
170 DWGL 0,3,0,"UN    ,DEUX  "
180 DWGL 16,3,&81,"MILIEU,DROITE"
190 PRINT :PRINT "ATTENDU [UN][DEUX](MILIEU)(DROITE)";
195 GOSUB 800
200 REM --- LES REFUS : ON ERROR LES AFFICHE ---
210 XCLS :LOCATE 0,0:PRINT "5 REFUS :";
220 ON ERROR GOTO 900
230 DWGL 0,4,0,"A"
240 DWGL 1,3,0,"A,B,C,D,E"
250 DWGL 0,3,0,"A,B,C,D,E,F"
260 DWGL 0,3,0,""
270 DWGL 0,3,0,5
280 DWGL 0,3,0,SREPT$ (6,"12345678")
290 DWGL 0,3;0,"A"
300 ON ERROR GOTO 0
310 PRINT :PRINT "ATTENDU 33 33 33 90 90 33 10";
320 GOSUB 800
330 REM --- DIX CHOIX : LE MODELE DE LA ROM, UN DRAPEAU DE PAGE ---
340 P=0
350 XCLS :LOCATE 0,0:PRINT "PF1-PF4 CHOISIT, PF5 CHANGE";
360 IF P=0 THEN DWGL 0,3,0,"BASIC ,DUMPM ,DRIVER,TRDOS ,SUITE "
370 IF P=1 THEN DWGL 0,3,1,"UUENC ,RENUM ,HIST  ,REGIS ,RETOUR"
380 K$=INKEY$ &1:IF K$="" THEN 380
390 N=ASC K$-&F0:IF N<1 OR N>5 THEN 380
400 IF N=5 THEN P=1-P:GOTO 350
410 XCONSOLE :CLS :PRINT "CHOIX ";N+5*P:END
800 IF INKEY$ 1="" THEN 800
810 RETURN
900 PRINT ERN;:RESUME NEXT
