10 REM DWGLTEST : L'INSTRUCTION DWGL -- LA BARRE DE CASES (IOCS 58H)
20 REM CHARGER D'ABORD BASEXT (CALL &BF000) OU LE PILOTE BASEXT-DRV
30 REM LA LIGNE 3 EST LIBEREE PAR XCONSOLE 0,3 ; EFFACER PAR XCLS, JAMAIS
40 REM PAR CLS : SOUS 4 LIGNES, CLS REDESSINE LES LIBELLES FUNCKEY EN LIGNE 3
50 CLS :XCONSOLE 0,3:XCLS
60 LOCATE 0,0:PRINT "1 CROCHETS, 5 CASES";
70 DWGL 0,3,0,"BASIC ,DUMPM ,DRIVER,TRDOS ,SUITE "
80 GOSUB 800
90 XCLS :LOCATE 0,0:PRINT "2 PARENTHESES (TAG 1)";
100 DWGL 0,3,1,"UUENC ,RENUM ,HIST  ,REGIS ,RETOUR"
110 GOSUB 800
120 XCLS :LOCATE 0,0:PRINT "3 COURT, LONG, UNE CASE";
130 DWGL 0,3,0,"A,TROPLONGPOURSIX,C"
140 PRINT :PRINT "ATTENDU [A     ][TROPLO][C     ]";
150 GOSUB 800
160 XCLS :LOCATE 0,0:PRINT "4 TAG &81 : GARDE + PAREN";
170 DWGL 0,3,0,"UN    ,DEUX  "
180 DWGL 16,3,&81,"MILIEU,DROITE"
190 PRINT :PRINT "ATTENDU [UN][DEUX](MILIEU)(DROITE)";
200 GOSUB 800
210 REM --- LE MARQUEUR DE L'ECRAN MENU, EN BASIC ---
220 REM MOTIF 0A1B1B0A LU EN 0E229DH ; LA ROM LE POSE EN X=1, SOMMET Y=18.
230 REM GCURSOR PREND LE BAS DE LA COLONNE DE 8 POINTS (IL PASSE Y-7 A LA
240 REM COMMANDE 4AH, 0FD3D7H), D'OU 25. EN GENERAL : (6*COLONNE+1, 8*LIGNE+1)
245 REM LE TRACER **AVANT** LA BARRE. GPRINT MET DOTSOP A 0 (0FD350H) ET
246 REM ECRIT LA COLONNE DE HUIT POINTS **ENTIERE**, BITS A ZERO COMPRIS :
247 REM SES TROIS POINTS VIDES DU BAS EFFACERAIENT LE HAUT DU CROCHET.
248 REM MESURE LE 2026-10-18 (J.-F. ALBOUY) : DEUX LIGNES DE POINTS EN MOINS
249 REM AU CROCHET SI ON LE TRACE APRES. LA BARRE, TRACEE ENSUITE, REFAIT LA
250 REM LIGNE 3 ; ET DWGL N'EFFACE QUE CELLE-LA, DONC LE MARQUEUR SURVIT.
255 XCLS :LOCATE 0,0:PRINT "5 LE MARQUEUR";
260 GCURSOR (1,25):GPRINT "0A1B1B0A"
265 DWGL 0,3,0,"BASIC ,DUMPM ,DRIVER,TRDOS ,SUITE "
270 GOSUB 800
290 REM --- LES REFUS : ON ERROR LES AFFICHE ---
300 XCLS :LOCATE 0,0:PRINT "6 REFUS :";
310 ON ERROR GOTO 900
320 DWGL 0,4,0,"A"
330 DWGL 1,3,0,"A,B,C,D,E"
340 DWGL 0,3,0,"A,B,C,D,E,F"
350 DWGL 0,3,0,""
360 DWGL 0,3,0,5
370 DWGL 0,3,0,SREPT$ (6,"12345678")
380 DWGL 0,3;0,"A"
390 ON ERROR GOTO 0
400 PRINT :PRINT "ATTENDU 33 33 33 90 90 33 10";
410 GOSUB 800
420 REM --- DIX CHOIX, LE MODELE DE LA ROM : UN DRAPEAU DE PAGE ---
430 REM LA TOUCHE HAUT-BAS TOURNE LA PAGE. MESURE LE 2026-10-15 :
440 REM INKEY$ &1 REND &1E ; INPUT$ REND 0 PUIS &E. LES CINQ PF RESTENT
450 REM DES CHOIX, D'OU DIX CHOIX REELS, COMME L'ECRAN MENU DE LA MACHINE.
460 P=0:XCLS
465 GCURSOR (1,25):GPRINT "0A1B1B0A"
470 LOCATE 0,0:PRINT "PF1-PF5 = CHOIX, HAUT-BAS = PAGE";
480 IF P=0 THEN DWGL 0,3,0,"BASIC ,DUMPM ,DRIVER,TRDOS ,UUENC "
490 IF P=1 THEN DWGL 0,3,1,"RENUM ,HIST  ,REGIS ,TYCOM ,TRDOS2"
500 K$=INKEY$ &1:IF K$="" THEN 500
510 K=ASC K$:IF K=&1E THEN P=1-P:GOTO 470
520 N=K-&F0:IF N<1 OR N>5 THEN 500
530 XCONSOLE :CLS :PRINT "CHOIX ";N+5*P;" (PAGE ";P;")"
540 END
800 IF INKEY$ 1="" THEN 800
810 RETURN
900 PRINT ERN ;:RESUME NEXT
