10 REM MODDIAG -- CONTROLE RAPIDE DE MOD (A,B)
20 REM MAJUSCULES SEULES, ASCII, FICHIER EN CRLF
30 REM CHARGER APRES CALL &BF000, SINON MOD DEVIENT
40 REM UNE VARIABLE ET RIEN NE MARCHERA
50 REM MODULE 530 OCTETS DE &BF000 A &BF211
60 REM FICHIER BASEXT.OBJ ATTENDU : 546 OCTETS
70 CLS :OPEN "F:RESULT.BAS" FOR OUTPUT AS #1
80 REM 1 -- L EXTENSION EST-ELLE INSTALLEE
90 W=LPEEK &BFD0E:T=LPEEK (W+&90)
100 L$="TABLE "+HEX$ T+" ATTENDU BF1DB":GOSUB 500
110 IF T<>&BF1DB THEN L$="MODULE PERIME":GOSUB 500:GOTO 460
120 REM 2 -- LA ZONE LM COUVRE-T-ELLE LE MODULE
130 Z=LPEEK &BFD1A
140 L$="ZONE LM "+HEX$ Z+" TAILLE"+STR$ (&BFC00-Z):GOSUB 500
150 IF Z>&BF000 THEN L$="NON PROTEGE -- A_AREA &BF000":GOSUB 500
160 REM 3 -- LA FONCTION
170 A=1234:B=100:I=2
180 L$="MOD (A,B)  ="+STR$ MOD (A,B)+" SOIT 34":GOSUB 500
190 L$="MOD (A+1,B)="+STR$ MOD (A+1,B)+" SOIT 35":GOSUB 500
200 L$="MOD (I*3571,997)="+STR$ MOD (I*3571,997):GOSUB 500
210 L$="  SOIT 163":GOSUB 500
220 L$="MOD (ASC A,5)="+STR$ MOD (ASC "A",5)+" SOIT 0":GOSUB 500
230 REM 4 -- BP0-BP1 = LE CADRE POUSSE PAR EVAL
240 P0=PEEK &BF20A:P1=PEEK &BF20B
250 L$="BP0"+STR$ P0+" BP1"+STR$ P1+" CADRE"+STR$ (P0-P1):GOSUB 500
260 REM 5 -- LES CROCHETS D ORIGINE
270 L$="OLD_KW "+HEX$ LPEEK &BF20C:GOSUB 500
280 REM ZERO = INSTALLE PAR-DESSUS UNE AUTRE EXTENSION,
290 REM DONC PAS DE DESINSTALLATION POSSIBLE
460 CLOSE :PRINT "FIN -- VOIR F:RESULT.BAS":END
500 REM ECRIT A L ECRAN ET DANS LE FICHIER
510 PRINT L$:PRINT #1, L$:RETURN
