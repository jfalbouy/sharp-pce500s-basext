10 REM XCONTEST : XCONSOLE ET XCLS
20 ON ERROR GOTO 900
30 CLS:FOR L=0 TO 3:LOCATE 0,L:PRINT "LIGNE";L;:NEXT L:GOSUB 800
40 XCONSOLE 1,2:XCLS:PRINT "1-2 H=";PEEK &BFC9E;:GOSUB 800
50 XCONSOLE 2:XCLS:PRINT "2-3 H=";PEEK &BFC9E;:GOSUB 800
60 XCONSOLE ,2:XCLS:PRINT "0-1 H=";PEEK &BFC9E;:GOSUB 800
70 XCONSOLE:CLS:PRINT "0-3 H=";PEEK &BFC9E
80 XCONSOLE 4
90 XCONSOLE 1,4
100 XCONSOLE 0,0
110 XCONSOLE "A"
120 XCONSOLE 1;2
130 PRINT:PRINT "ATTENDU 33 33 33 90 10":END
800 FOR T=1 TO 500:NEXT T:RETURN
900 PRINT ERN;:RESUME NEXT
