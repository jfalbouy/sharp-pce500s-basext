10 REM MODTEST -- LA FONCTION MOD (A,B)
20 REM MAJUSCULES SEULES, ASCII, FICHIER EN CRLF
30 REM CHARGER APRES CALL &BF000
40 REM DOMAINE : ENTIERS DE 0 A 1048575
50 CLS
60 REM 1 -- LES CAS SIMPLES
70 PRINT MOD (17,5);MOD (100,7);MOD (9,3)
80 PRINT "SOIT 2 2 0"
90 REM 2 -- LES BORNES
100 PRINT MOD (1048575,1000);MOD (1048575,1);MOD (0,7)
110 PRINT "SOIT 575 0 0"
120 REM 3 -- DIVISEUR PLUS GRAND QUE LE DIVIDENDE
130 PRINT MOD (6,7);MOD (7,7)
140 PRINT "SOIT 6 0"
150 REM 4 -- ARGUMENTS EXPRESSIONS
160 A=1234:B=100
170 PRINT MOD (A,B);MOD (A+1,B);MOD (A*2,B+1)
180 PRINT "SOIT 34 35 44"
190 REM 5 -- CONTROLE CROISE PAR LE BASIC LUI-MEME
200 E=0
210 FOR I=1 TO 40
220 V=MOD (I*3571,997)
230 W=I*3571-997*INT (I*3571/997)
240 IF V<>W THEN PRINT "ECART EN";I;V;W:E=E+1
250 NEXT I
260 IF E=0 THEN PRINT "40 CONTROLES OK" ELSE PRINT E;"ECARTS"
270 REM 6 -- CE QUI DOIT ETRE REFUSE
280 REM OTER LE REM D UNE SEULE LIGNE A LA FOIS
290 REM PRINT MOD (17,0)      ERREUR 21 DIVISION BY ZERO
300 REM PRINT MOD (-17,5)     ERREUR 33 DATA OUT OF RANGE
310 REM PRINT MOD (1048576,5) ERREUR 33 DATA OUT OF RANGE
320 REM PRINT MOD 17,5        ERREUR 10 SYNTAX ERROR
330 REM PRINT MOD ("A",5)     ERREUR 90 TYPE MISMATCH
340 END
