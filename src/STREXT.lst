0BF248                   	; ============================================================================
0BF248                   	; SREPT$ (nombre, chaine)  --  <nombre> repetitions de la CHAINE ENTIERE
0BF248                   	; ============================================================================
0BF248                   	; SREPT$(3,"ABC") -> "ABCABCABC". resultat = nombre * longueur, <= 255.
0BF248                   	; Comme REPT$ mais copie toute la chaine. La chaine s$ est sur U [U, U+L) ; on
0BF248                   	; abaisse U de (resultlen - L) et on recopie s$ (n-1) fois SOUS la copie du haut
0BF248                   	; (qui est deja s$), pour finir au ras de la pile.
0BF248 00 00 00          	srept_m3: db    0,0,0
0BF24B                   	srept:
0BF24B                   	sr_sp:
0BF24B 90 24             	        mv      a,[x++]
0BF24D 60 20             	        cmp     a,020H
0BF24F 19 06             	        jrz     sr_sp
0BF251 60 28             	        cmp     a,028H
0BF253 1A C8             	        jrnz    sr_syn0
0BF255 30 D8 DC F4 0B EC 	        mv      [!sv_bp0],(bp_ram)
0BF25B 05 6E F2 0E       	        callf   eval                    ; arg1 : nombre
0BF25F 1C C2             	        jrc     sr_ret
0BF261 30 D8 DD F4 0B EC 	        mv      [!sv_bp1],(bp_ram)
0BF267 65 00 80          	        test    (BP+0),080H
0BF26A 1A C0             	        jrnz    sr_type
0BF26C 05 D4 FA 0E       	        callf   dec2bin
