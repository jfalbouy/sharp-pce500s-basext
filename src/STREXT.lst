0BF0CA                   	; (BP+5) = decalage de debut ; (BP+6) = longueur elaguee ; (BP+4) = longueur d'origine.
0BF0CA 00 00 00          	trim_m3:  db    0,0,0
0BF0CD                   	trim:
0BF0CD 08 00             	        mv      a,000H
