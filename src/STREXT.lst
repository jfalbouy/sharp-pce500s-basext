0BF109                   	
0BF109                   	; --- espaces de debut (sauf RTRIM) ---
0BF109 CC 05 00          	        mv      (BP+5),000H
0BF10C 88 DE F4 0B       	        mv      a,[!tmode]
0BF110 60 02             	        cmp     a,002H
0BF112 18 1A             	        jrz     tr_nolead
0BF114 FD 56             	        mv      y,u
0BF116                   	tr_ld:
