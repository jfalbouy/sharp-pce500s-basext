000000                   	; ============================================================================
000000                   	; STREXT.ASM -- FONCTIONS CHAINE ajoutees au BASIC (fusionnees dans BASEXT.ASM)
000000                   	; ============================================================================
000000                   	; Convention chaine ETABLIE SUR MACHINE le 2026-09-14 :
000000                   	;
000000                   	;   LIRE un argument chaine (d'apres SUB_FC613, lecteur de LEFT$) :
000000                   	;     callf eval ; test (BP+0),080h  (bit 7 = chaine, sinon erreur 90)
000000                   	;     -> chaine SUR U (adresse = U), longueur en (BP+4). eval a deja pose
000000                   	;        (BP+0)=080h et (BP+1)=U, et ABAISSE BP de 15 (comme chknum).
000000                   	;
000000                   	;   RENDRE une chaine : (BP+0)=080h ; (BP+1)=U ; (BP+4)=IL, avec BP au cadre
000000                   	;     d'UN SEUL eval (BP d'entree - 15), SANS pmdf -- la convention de LEFT$,
000000                   	;     dont la fin LOC_FD7D3 n'a aucun pmdf. Le resultat DOIT etre a l'adresse U,
000000                   	;     IL = sa longueur.
000000                   	;     ⛔ CET EN-TETE DISAIT « repliquer LOC_FD6F9 : pmdf (bp_ram),0F1h
000000                   	;        INDISPENSABLE ». FAUX EN GENERAL (corrige le 2026-09-15) : LOC_FD6F9
000000                   	;        finit CHR$, dont le lecteur a DEJA rendu son cadre (0F5C58h fait
000000                   	;        pmdf +15) ; son -15 ne fait que le reconstituer. Le ret_str ci-dessous,
000000                   	;        valide sur machine, n'a pas de pmdf. Ce qui compte est le bilan net.
000000                   	;        Reference : C:\Claude\BASEXT\MODE-EMPLOI.md §6.1.
000000                   	;
000000                   	; ⛔ LE RESULTAT DOIT REMPLACER L'ARGUMENT SUR U, SANS LAISSER DE TROU (sinon la
000000                   	;    concatenation « "["+TRIM$(...) » corrompt "["). Comme LEFT$ :
000000                   	;      UCASE$/LCASE$ : transformation SUR PLACE ;
000000                   	;      TRIM*         : sous-plage copiee AU SOMMET de la zone argument, U remonte ;
000000                   	;      REPT$         : U ajuste pour finir ou finissait l'argument.
000000                   	;
000000                   	; ⛔ REPT$ fait DEUX eval (nombre puis chaine) : chacun abaisse BP de 15. On
000000                   	;    RESTAURE BP au cadre du 1er eval (sv_bp1) avant de finaliser, comme MOD,
000000                   	;    pour que le resultat soit au meme cadre que les fonctions a un seul argument.
000000                   	;
000000                   	; ⛔ X = point de reprise : on scanne avec Y ; pour une copie a deux pointeurs on
000000                   	;    sauve X sur la pile SYSTEME. ORDRE IMPOSE : charger, CALL, VERIFIER, saisir.
000000                   	;
000000                   	;   PRINT "["+TRIM$ ("  ab  ")+"]"     [ab]
000000                   	;   PRINT REPT$ (5,"*")                *****
000000                   	;
000000                   	;       xasm2026-4 STREXT.ASM -O -L -S -B -K
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	basptr: equ 0D1H ; POINTEUR (3 octets) vers la zone de travail de l'interpreteur BASIC, en RAM interne. C'est la COPIE de celui que la ROM lit en 0BFD0Eh (baswrk) : elle la fait par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Les crochets d'extension du BAS ...
000000                   	bp_ram: equ 0ECH ; base pointer RAM interne
000000                   	
000000                   	eval:     equ   0EF26EH    ; expression complete ; abaisse BP de 15 ; bit 7 (BP+0)=chaine
000000                   	dec2bin:  equ   0EFAD4H    ; nombre -> entier 24 bits en (BP+1)..(BP+3)
000000                   	bin2dec:  equ   0EFB6FH    ; entier (BP+0)..(BP+3) -> nombre BASIC (entree RETF)
000000                   	alloc:    equ   0EF0DDH    ; reserve BA octets sur U (U -= BA) ; carry = erreur 54
000000                   	
000000                   	tk_uc:    equ   0C6H
000000                   	tk_lc:    equ   0C7H
000000                   	tk_tr:    equ   0C3H
000000                   	tk_lt:    equ   0C4H
000000                   	tk_rt:    equ   0C5H
000000                   	tk_rp:    equ   0C8H
000000                   	tk_in:    equ   0C2H       ; INSTR (rend un NOMBRE)
000000                   	tk_sr:    equ   0C9H       ; SREPT$
000000                   	
000000                   	err_syn:  equ   00AH       ; 10 Syntax error
000000                   	err_type: equ   05AH       ; 90 Type mismatch
000000                   	err_range: equ  021H       ; 33 Data out of range
000000                   	err_buf:  equ   036H       ; 54 Buffer space exceeded
000000                   	
0BF000                   	        org     0BF000H
0BF000                   	        pre_on
0BF000                   	
0BF000                   	; ============================================================================
0BF000                   	; INSTALLATION
0BF000                   	; ============================================================================
0BF000                   	start:
0BF000 2C                	        pushu   x
0BF001 2B                	        pushu   i
0BF002 30 84 D1          	        mv      x,(basptr)
0BF005 90 84 92          	        mv      a,[x+092H]
0BF008 60 0F             	        cmp     a,00FH
0BF00A 1A 0E             	        jrnz    deja_ext
0BF00C 95 84 90          	        mv      y,[x+090H]
0BF00F AD EA F4 0B       	        mv      [old_kw],y
0BF013 95 84 93          	        mv      y,[x+093H]
0BF016 AD ED F4 0B       	        mv      [old_disp],y
0BF01A                   	deja_ext:
0BF01A 0D 7D F4 0B       	        mv      y,kw_table
0BF01E B5 84 90          	        mv      [x+090H],y
0BF021 0D BB F4 0B       	        mv      y,disp_table
0BF025 B5 84 93          	        mv      [x+093H],y
0BF028 3B                	        popu    i
0BF029 3C                	        popu    x
0BF02A 9F                	        rc
0BF02B 07                	        retf
0BF02C                   	
0BF02C                   	; ============================================================================
0BF02C                   	; PRIMITIVES PARTAGEES
0BF02C                   	; ============================================================================
0BF02C                   	; rd1str -- lit '(' expr_chaine ')'. CY=0 : chaine sur U, longueur (BP+4).
0BF02C                   	;           CY=1 : A = code d'erreur.  APPEL PROCHE.
0BF02C                   	rd1str:
0BF02C                   	rd_sp:
0BF02C 90 24             	        mv      a,[x++]
0BF02E 60 20             	        cmp     a,020H
0BF030 19 06             	        jrz     rd_sp
0BF032 60 28             	        cmp     a,028H
0BF034 18 06             	        jrz     rd_ev
0BF036 7C 04             	        dec     x
0BF038 08 0A             	        mv      a,err_syn
0BF03A 97                	        sc
0BF03B 06                	        ret
0BF03C                   	rd_ev:
0BF03C 30 D8 DC F4 0B EC 	        mv      [!sv_bp0],(bp_ram)
0BF042 05 6E F2 0E       	        callf   eval
0BF046 1C 21             	        jrc     rd_er
0BF048 65 00 80          	        test    (BP+0),080H
0BF04B 18 10             	        jrz     rd_ty
0BF04D 90 24             	        mv      a,[x++]
0BF04F 60 29             	        cmp     a,029H
0BF051 18 14             	        jrz     rd_ok
0BF053 30 D0 EC DC F4 0B 	        mv      (bp_ram),[!sv_bp0]
0BF059 08 0A             	        mv      a,err_syn
0BF05B 97                	        sc
0BF05C 06                	        ret
0BF05D                   	rd_ty:
0BF05D 30 D0 EC DC F4 0B 	        mv      (bp_ram),[!sv_bp0]
0BF063 08 5A             	        mv      a,err_type
0BF065 97                	        sc
0BF066 06                	        ret
0BF067                   	rd_ok:
0BF067 9F                	        rc
0BF068 06                	        ret
0BF069                   	rd_er:
0BF069 06                	        ret
0BF06A                   	
0BF06A                   	; ret_str -- finaliseur, CONVENTION DE LEFT$ (LOC_FD7D3, 2026-09-14) : ecrire
0BF06A                   	;   (BP+1)=U et (BP+4)=longueur, garder (BP+0)=080h d'eval, NE PAS TOUCHER BP,
0BF06A                   	;   NI DE pmdf. Le pmdf casse la concatenation (il deseequilibre l'evaluateur
0BF06A                   	;   d'expression). BP doit etre au cadre d'UN SEUL eval a l'entree ici (REPT$,
0BF06A                   	;   qui en fait deux, restaure sv_bp1 avant de venir).
0BF06A                   	; U = base du resultat, IL = longueur.
0BF06A                   	ret_str:
0BF06A CC 00 80          	        mv      (BP+0),080H
0BF06D A6 01             	        mv      (BP+1),u
0BF06F A1 04             	        mv      (BP+4),il
0BF071 9F                	        rc
0BF072 07                	        retf
0BF073                   	
0BF073                   	st_err:
0BF073 07                	        retf
0BF074                   	
0BF074                   	; ============================================================================
0BF074                   	; UCASE$ / LCASE$  --  transformation SUR PLACE
0BF074                   	; ============================================================================
0BF074 00 00 00          	ucase_m3: db    0,0,0
0BF077                   	ucase:
