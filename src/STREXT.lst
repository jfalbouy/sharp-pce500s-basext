0BF0B5 1C 06             	        jrc     lc_pt
0BF0B7 60 5B             	        cmp     a,05BH
0BF0B9 1E 02             	        jrnc    lc_pt
0BF0BB 40 20             	        add     a,020H
0BF0BD                   	lc_pt:
0BF0BD B0 05             	        mv      [y],a
0BF0BF 6C 05             	        inc     y
0BF0C1 7C 01             	        dec     il
0BF0C3 1B 14             	        jrnz    lc_lp
0BF0C5                   	lc_end:
0BF0C5 81 04             	        mv      il,(BP+4)
0BF0C7 02 6A F0          	        jp      ret_str
