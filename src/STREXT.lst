0BF11E 60 20             	        cmp     a,020H
0BF120 1A 0C             	        jrnz    tr_nolead
0BF122 6C 05             	        inc     y
0BF124 7C 01             	        dec     il
0BF126 80 05             	        mv      a,(BP+5)
0BF128 6C 00             	        inc     a
0BF12A A0 05             	        mv      (BP+5),a
0BF12C 13 18             	        jr      tr_ld
0BF12E                   	tr_nolead:
0BF12E A1 06             	        mv      (BP+6),il
0BF130                   	
0BF130                   	; --- copier la sous-plage AU SOMMET de la zone argument (haut vers bas) ---
0BF130 B4 37             	        pushs   x
