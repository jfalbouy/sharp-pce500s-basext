0BF0EA                   	lp_back:
0BF0EA 7C 04             	        dec     x               ; rendre le caractere qui n'etait pas une virgule
0BF0EC                   	lp_ret:
0BF0EC 07                	        retf
0BF0ED                   	
0BF0ED                   	lp_syn:
0BF0ED 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BF0F1 08 0A             	        mv      a,err_syn
0BF0F3 97                	        sc
0BF0F4 07                	        retf
