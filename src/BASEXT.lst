0BF56A 1A AF             	        jrnz    in_syn
0BF56C 05 6E F2 0E       	        callf   eval                ; recherche
0BF570 1C 97             	        jrc     in_bad
0BF572 65 00 80          	        test    (BP+0),080H
0BF575 18 9A             	        jrz     in_type
0BF577 90 24             	        mv      a,[x++]
0BF579 60 29             	        cmp     a,029H
0BF57B 1A 9E             	        jrnz    in_syn
0BF57D                   	; --- recherche : mise en place ---
0BF57D                   	; (BP+5) = maxp ; (BP+6) = octet temporaire de comparaison ; p en variable module
0BF57D                   	; (on n'utilise QUE (BP+5)/(BP+6), prouves surs ; le cadre d'eval peut ne pas
0BF57D                   	;  atteindre (BP+7)).
