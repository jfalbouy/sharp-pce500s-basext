0BF100                   	; ============================================================================
0BF100                   	; LA FONCTION MOD (A,B) -- le reste de la division entiere
0BF100                   	; ============================================================================
0BF100                   	; L'interpreteur y saute a modu_m3 + 3 : c'est une FONCTION (drapeau 040h).
0BF100                   	;
0BF100                   	;   PRINT MOD (17,5)      2
0BF100                   	;   R = MOD (A,B)
0BF100                   	;
0BF100                   	; ⛔ PAS D'INFIXE POSSIBLE. « A MOD B » est hors d'atteinte : la reconnaissance
0BF100                   	;    des operateurs est CABLEE EN DUR dans l'analyseur d'expression, en 0EF2C5h,
0BF100                   	;    par trois comparaisons litterales contre 0A1h (AND), 0A2h (OR) et 0A5h
0BF100                   	;    (XOR) -- ni table, ni plage, et nos deux crochets n'y donnent pas acces.
0BF100                   	;    La syntaxe est donc celle de POINT (x,y), que la machine possede deja.
0BF100                   	;
0BF100                   	; ⛔ ET LE CALCUL N'EMPRUNTE RIEN A LA BIBLIOTHEQUE FLOTTANTE DE LA ROM. Deux
0BF100                   	;    versions ont essaye de calculer A - B * INT (A/B) par les commandes du
0BF100                   	;    device 9 ; les deux ont plante la machine (CLS puis MENU principal), et la
0BF100                   	;    seconde alors meme que ses cinq adresses etaient JUSTES -- verifiees une a
0BF100                   	;    une dans la table de repartition DB_EF078 du driver drv_function :
0BF100                   	;
0BF100                   	;      047h add 0ECBA9h   048h sub 0ECBB4h   049h mul 0ECBBFh
0BF100                   	;      04Ah div 0ECBD8h   056h int 0EE4D5h
0BF100                   	;
0BF100                   	;    Ce que ces adresses ne disent pas, c'est le CONTRAT. Il y a deux diviseurs
0BF100                   	;    (SUB_ECCEA et SUB_ECD85), l'entree 04Ah ne mene qu'au second, et le seul
0BF100                   	;    appelant connu de la ROM -- l'evaluateur d'expression en 0E8559h -- fait
0BF100                   	;    « mv i,0000Fh / exl (000h),(00Fh) » AVANT d'appeler : il ECHANGE X et Y,
0BF100                   	;    ce que ne fait aucune des trois autres operations.
0BF100                   	;
0BF100                   	;    Le calcul est donc fait ici, en binaire, et ne s'appuie que sur des
0BF100                   	;    primitives EPROUVEES SUR LA MACHINE par LPEEK et LPOKE : chknum, dec2bin,
0BF100                   	;    bin2dec.
0BF100                   	;
0BF100                   	; ⛔ ET ON NE SUPPOSE RIEN DE CE QUE chknum FAIT DE BP. Une premiere version
0BF100                   	;    binaire tenait pour acquis qu'un chknum EMPILE un cadre de 15 octets, donc
0BF100                   	;    qu'apres le second appel le premier operande se lisait en (bp+16)..(bp+18).
0BF100                   	;    Je l'avais deduit d'un enchainement de la ROM en 0ECBCAh -- une inference,
0BF100                   	;    pas une mesure. LA MACHINE L'A DEMENTIE : elle rendait 0 pour toutes les
0BF100                   	;    valeurs, ce qui est la signature d'un A perdu (0 mod B, ou B mod B).
0BF100                   	;
0BF100                   	;    Plutot que de deviner une troisieme fois la taille et le sens du cadre,
0BF100                   	;    cette version REND LA QUESTION SANS OBJET :
0BF100                   	;      . le premier operande est mis a l'abri en RAM du module (sv_a) des que
0BF100                   	;        dec2bin l'a converti, donc avant que le second chknum ne puisse rien
0BF100                   	;        ecraser ;
0BF100                   	;      . BP est SAUVE et RESTAURE en absolu (sv_bp0, sv_bp1) au lieu d'etre
0BF100                   	;        rattrape par des pmdf comptes a la main.
0BF100                   	;    Le module se comporte alors exactement comme LPEEK, qui lui fonctionne :
0BF100                   	;    resultat en (bp+0)..(bp+3), BP tel qu'il etait apres LE PREMIER chknum.
0BF100                   	;    Que chknum empile 15 octets, 8, ou rien du tout, le resultat est le meme.
0BF100                   	;
0BF100                   	; LE DOMAINE : A et B sont des ENTIERS de 0 a 1048575, celui de LPEEK et de
0BF100                   	; LPOKE. La borne n'est pas un choix mais une mesure : dec2bin accumule dans X,
0BF100                   	; registre de 20 bits, et REFUSE lui-meme au-dela (« add x,a / jrc » en
0BF100                   	; 0EFAFBh, puis erreur 33) -- c'est donc la ROM, et non nous, qui signale un
0BF100                   	; operande trop grand. Un operande negatif est refuse ici : dec2bin en rend la
0BF100                   	; valeur absolue en laissant le signe dans le bit 3 de (bp+0), donc l'ignorer
0BF100                   	; rendrait un resultat faux en silence. Le reste etant toujours < B, il tient
0BF100                   	; toujours dans les 20 bits que bin2dec sait reconvertir.
0BF100                   	
0BF100                   	modu_m3:
0BF100 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BF103                   	
0BF103                   	modu:
0BF103                   	; ⛔ LES PARENTHESES SONT OBLIGATOIRES, ET C'EST LA ROM QUI LE DIT.
0BF103                   	;    SUB_FD5E7, le lecteur d'arguments de POINT (x,y), exige TROIS caracteres :
0BF103                   	;    '(' en 0FD5ECh, ',' en 0FD5F9h et ')' en 0FD60Ah. Une premiere version de
0BF103                   	;    cette fonction n'en verifiait qu'un : chknum recevait (17,5) tout entier et
0BF103                   	;    tentait d'evaluer une expression parenthesee. PRINT MOD(17,5) repondait
0BF103                   	;    Syntax error. Constate sur emulateur, corrige en relisant SUB_FD5E7.
0BF103                   	md_sp:
0BF103 90 24             	        mv      a,[x++]
0BF105 60 20             	        cmp     a,020H          ; sauter les espaces -- ce que fait SUB_FB2D9
0BF107 19 06             	        jrz     md_sp
0BF109 60 28             	        cmp     a,028H          ; '(' obligatoire
0BF10B 1A 98             	        jrnz    md_syn0
0BF10D                   	
0BF10D                   	; BP a l'entree : l'etat a rendre si l'on doit signaler une erreur, puisque
0BF10D                   	; c'est celui d'avant tout ce que nous avons pu prendre.
0BF10D 30 D8 B8 F6 0B EC 	        mv      [!sv_bp0],(bp_ram)
0BF113                   	
0BF113                   	; --- A, le dividende --------------------------------------------------------
0BF113 05 6E F2 0E       	        callf   eval            ; expression complete -> (bp+0)
0BF117 1C 8B             	        jrc     md_ret          ; echec : rien n'a ete pris
0BF119 65 00 80          	        test    (BP+0),080H     ; bit 7 : c'est une chaine
0BF11C 1A 9F             	        jrnz    md_type
0BF11E                   	
0BF11E                   	; ⛔ BP D'APRES LA PREMIERE EVALUATION, SAUVE EN ABSOLU. Le cadre pousse par
0BF11E                   	;    chknum vaut 15 octets, MESURE sur machine (BP 150 -> 135). Celui d'eval
0BF11E                   	;    ne l'est PAS : je ne le suppose donc pas, et je restaure BP par sa valeur
0BF11E                   	;    plutot que par un pmdf compte a la main. sv_bp0 et sv_bp1 etant tous deux
0BF11E                   	;    lisibles depuis le BASIC, l'ecart se mesurera au prochain essai.
0BF11E 30 D8 B9 F6 0B EC 	        mv      [!sv_bp1],(bp_ram)
