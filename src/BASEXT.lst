0BF62C                   	; LES QUATRE ENTREES
0BF62C                   	; ============================================================================
0BF62C                   	kw_table:
0BF62C 05 4C 50 45 45 4B 	        db      5,'LPEEK',tk_lp
0BF632 07                	
0BF633 05 57 50 45 45 4B 	        db      5,'WPEEK',tk_wp
0BF639 0A                	
0BF63A 05 4C 50 4F 4B 45 	        db      5,'LPOKE',tk_lpo
0BF640 0E                	
0BF641 03 4D 4F 44 0F    	        db      3,'MOD',tk_mod
0BF646 06 55 43 41 53 45 	        db      6,'UCASE$',tk_uc
0BF64C 24 C6             	
0BF64E 06 4C 43 41 53 45 	        db      6,'LCASE$',tk_lc
0BF654 24 C7             	
0BF656 05 54 52 49 4D 24 	        db      5,'TRIM$',tk_tr
0BF65C C3                	
0BF65D 06 4C 54 52 49 4D 	        db      6,'LTRIM$',tk_lt
0BF663 24 C4             	
0BF665 06 52 54 52 49 4D 	        db      6,'RTRIM$',tk_rt
0BF66B 24 C5             	
0BF66D 05 52 45 50 54 24 	        db      5,'REPT$',tk_rp
0BF673 C8                	
0BF674 06 53 52 45 50 54 	        db      6,'SREPT$',tk_sr
0BF67A 24 C9             	
0BF67C 05 49 4E 53 54 52 	        db      5,'INSTR',tk_in
0BF682 C2                	
0BF683 00                	        db      0                       ; fin de table
0BF684                   	
0BF684                   	disp_table:
0BF684                   	; Trois entrees de 4 octets, puis le terminateur. Le quartet haut du 3e octet
0BF684                   	; d'adresse est un DRAPEAU : 040h = fonction, routine a l'adresse + 3 ; 080h =
0BF684                   	; instruction, routine a l'adresse telle quelle. LPOKE est du second genre, et
0BF684                   	; n'a donc pas de prefixe de trois octets.
0BF684 07                	        db      tk_lp
0BF685 2C                	        db      lpeek_m3
0BF686 F0                	        db      lpeek_m3/256
0BF687 4B                	        db      lpeek_m3/65536+040H
0BF688 0A                	        db      tk_wp
0BF689 6E                	        db      wpeek_m3
0BF68A F0                	        db      wpeek_m3/256
0BF68B 4B                	        db      wpeek_m3/65536+040H
0BF68C 0E                	        db      tk_lpo
0BF68D A4                	        db      lpoke
0BF68E F0                	        db      lpoke/256
0BF68F 8B                	        db      lpoke/65536+080H
0BF690 0F                	        db      tk_mod
0BF691 00                	        db      modu_m3
0BF692 F1                	        db      modu_m3/256
0BF693 4B                	        db      modu_m3/65536+040H
0BF694 C6 23 F2 4B       	        db      tk_uc, ucase_m3, ucase_m3/256, ucase_m3/65536+040H
0BF698 C7 4E F2 4B       	        db      tk_lc, lcase_m3, lcase_m3/256, lcase_m3/65536+040H
0BF69C C3 79 F2 4B       	        db      tk_tr, trim_m3,  trim_m3/256,  trim_m3/65536+040H
0BF6A0 C4 80 F2 4B       	        db      tk_lt, ltrim_m3, ltrim_m3/256, ltrim_m3/65536+040H
0BF6A4 C5 87 F2 4B       	        db      tk_rt, rtrim_m3, rtrim_m3/256, rtrim_m3/65536+040H
0BF6A8 C8 12 F3 4B       	        db      tk_rp, rept_m3,  rept_m3/256,  rept_m3/65536+040H
0BF6AC C9 F7 F3 4B       	        db      tk_sr, srept_m3, srept_m3/256, srept_m3/65536+040H
0BF6B0 C2 05 F5 4B       	        db      tk_in, instr_m3, instr_m3/256, instr_m3/65536+040H
0BF6B4 00                	        db      0                       ; fin de table
0BF6B5                   	
0BF6B5                   	; ============================================================================
0BF6B5                   	; LES CROCHETS D'ORIGINE, pour desinstaller
0BF6B5                   	; ============================================================================
0BF6B5                   	; Le premier operande, hors d'atteinte du second chknum. Il n'est PLUS ecrase
0BF6B5                   	; ensuite : apres un appel, LPEEK &BF1EC rend A tel que dec2bin l'a converti.
0BF6B5                   	; C'est notre seul point de mesure, et le module doit rester assez court pour
0BF6B5                   	; que le BASIC ne vienne pas le manger -- le vidage du 2026-09-05 montre du
0BF6B5                   	; texte BASIC des 0BF1F7h.
0BF6B5 00 00 00          	sv_a:     db    0,0,0
0BF6B8 00                	sv_bp0:   db    0             ; BP a l'entree -- l'etat a rendre en erreur
0BF6B9 00                	sv_bp1:   db    0             ; BP apres la 1re evaluation -- cadre du resultat
0BF6BA                   	
0BF6BA                   	; ⛔ LES TROIS TEMOINS DE MESURE ONT ETE RETIRES LE 2026-09-05, une fois MOD
0BF6BA                   	;    valide sur machine. Ils portaient A et B tels que dec2bin les rendait, et le
0BF6BA                   	;    reste au sortir de la boucle ; c'est par eux que la cause a ete trouvee deux
0BF6BA                   	;    fois, la ou le raisonnement s'etait trompe. Les remettre est l'affaire de
0BF6BA                   	;    trois « mvp [!dbg_x],(BP+n) » et de trois mots de 3 octets -- le faire
0BF6BA                   	;    plutot que de deviner, si la fonction se remet a mentir.
0BF6BA                   	
0BF6BA                   	
0BF6BA 00                	tmode:    db    0
0BF6BB 00                	rp_n:     db    0
0BF6BC 00                	rp_c:     db    0
0BF6BD 00                	in_start: db    0
0BF6BE 00                	in_lt:    db    0
0BF6BF 00                	in_res:   db    0
0BF6C0 00                	in_p:     db    0
0BF6C1 00                	sr_n:     db    0
0BF6C2 00                	sr_cnt:   db    0
0BF6C3 00 00 00          	sr_src:   db    0,0,0
0BF6C6 00 00 00          	old_kw:   db    0,0,0
0BF6C9 00 00 00          	old_disp: db    0,0,0
0BF6CC                   	
0BF6CC                   	        end

