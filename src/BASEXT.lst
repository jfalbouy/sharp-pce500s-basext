0BF70F                   	; ============================================================================
0BF70F                   	; XCLS  --  efface la fenetre de XCONSOLE (INSTRUCTION)
0BF70F                   	; ============================================================================
0BF70F                   	; Pendant de CLS, qui reste celui de la ROM et efface les lignes 0 ..
0BF70F                   	; lcd_height-1, lignes figees comprises. XCLS n'efface que xc_top ..
0BF70F                   	; lcd_height-1 et place le curseur en (0,xc_top).
0BF70F                   	;
0BF70F                   	; Calque sur 0F9307h, la fin de CLS, avec les commandes documentees du device 0 :
0BF70F                   	;   CLS  : 51h clear_disp            / 45h cursor_type, BA=0 / curseur (0,0)
0BF70F                   	;   XCLS : 49h clear_line par ligne  / 45h cursor_type, BA=0 / curseur (0,xc_top)
0BF70F                   	; et, comme CLS (0F9367h), les bits 0-1 de [(basptr)+070h] remis a zero --
0BF70F                   	; ceux que LOCATE arme (0FC698h).
0BF70F                   	;
0BF70F                   	; La hauteur est RELUE dans lcd_height a chaque appel, et non memorisee : si
0BF70F                   	; l'editeur l'a changee, XCLS suit la ROM au lieu de la contredire.
0BF70F                   	xcls:
0BF70F 2C                	        pushu   x                       ; le point de reprise
0BF710 2B                	        pushu   i
0BF711 88 9B F9 0B       	        mv      a,[!xc_top]
0BF715 A8 9C F9 0B       	        mv      [!xcl_y],a
0BF719                   	xl_loop:
0BF719 88 9C F9 0B       	        mv      a,[!xcl_y]
0BF71D 30 A0 D5          	        mv      (bh),a                  ; ordonnee de la ligne (argument de 49h)
0BF720 88 9E FC 0B       	        mv      a,[lcd_height]
0BF724 30 63 D5          	        cmp     (bh),a                  ; ligne - hauteur : NC = hors fenetre
0BF727 1E 17             	        jrnc    xl_done
0BF729 30 CD D6 00 00    	        mvw     (cl),00000H             ; device 0, lecteur 0
0BF72E 09 49             	        mv      il,d0_clear_line
0BF730 05 E8 FF 0F       	        callf   iocs_call
0BF734 88 9C F9 0B       	        mv      a,[!xcl_y]
0BF738 6C 00             	        inc     a
0BF73A A8 9C F9 0B       	        mv      [!xcl_y],a
0BF73E 13 27             	        jr      xl_loop
0BF740                   	xl_done:
0BF740 09 45             	        mv      il,d0_cursor_type
0BF742 4C 22             	        sub     ba,ba                   ; pas de curseur, comme 0F930Eh
0BF744 30 CD D6 00 00    	        mvw     (cl),00000H
0BF749 05 E8 FF 0F       	        callf   iocs_call
0BF74D 08 00             	        mv      a,000H
0BF74F A8 27 FC 0B       	        mv      [scrn_crsr_x],a
0BF753 88 9B F9 0B       	        mv      a,[!xc_top]
0BF757 A8 28 FC 0B       	        mv      [scrn_crsr_y],a
0BF75B 30 84 D1          	        mv      x,(basptr)
0BF75E 90 84 70          	        mv      a,[x+070H]
0BF761 70 FC             	        and     a,0FCH                  ; les bits de LOCATE, comme CLS
0BF763 B0 84 70          	        mv      [x+070H],a
0BF766 3B                	        popu    i
0BF767 3C                	        popu    x
0BF768 9F                	        rc
0BF769 07                	        retf
0BF76A                   	
0BF76A                   	; ============================================================================
0BF76A                   	; LE FILTRE D'ECRITURE DE STDO:  --  confine le defilement a la fenetre
0BF76A                   	; ============================================================================
0BF76A                   	; ⛔ LE FILTRE NE SE CHAINE PAS DANS d_link, ET C'EST LA MACHINE QUI LE DIT.
0BF76A                   	;    L'ecriture par le FCS ne passe PAS par iocs_call : en 0E0907h, il saute
0BF76A                   	;    (retf) a l'adresse rangee en [bloc+2] du bloc de controle du handle, et
0BF76A                   	;    cette adresse est memorisee a l'OUVERTURE (0E07F1h). Releve dans la System
0BF76A                   	;    Data Area d'un PC-E500S reel (Samples/Extraction/s1-1.bin) :
0BF76A                   	;
0BF76A                   	;      bloc du handle 0 en 0BEE48h : 00 00 E7 21 0F A2 02
0BF76A                   	;                                    |  |  \______/ \
0BF76A                   	;                                device lecteur  0F21E7h = drv_display, attribut
0BF76A                   	;
0BF76A                   	;    Un en-tete ajoute en tete de d_link (la methode de MEMCHECK) ne verrait donc
0BF76A                   	;    jamais un PRINT. On remplace l'adresse du bloc du handle 0 par xf_entry, et
0BF76A                   	;    le filtre transmet a l'ancienne adresse -- recopiee dans les operandes de
0BF76A                   	;    xf_pass et xf_call (auto-modification, comme MEMCHECK). Si la ROM rouvre
0BF76A                   	;    STDO:, le filtre disparait simplement : l'echec est sans danger.
0BF76A                   	;
0BF76A                   	; LE BLOC DE CONTROLE se trouve comme en 0E0698h / 0E066Ah :
0BF76A                   	;    numero = [fhandle + handle] ; bloc = [(iocsw)] + [(iocsw)+25h]
0BF76A                   	;    + numero * 1Fh, borne par [(iocsw)+27h] ; octet 0 = device (0FFh = libre).
0BF76A                   	;
0BF76A                   	; LE PRINCIPE : DEFILER AVANT LA ROM. Pour un octet, le pilote fait (0F2A47h) :
0BF76A                   	;    affichable        : retour a la ligne differe (0F2B57h : X >= largeur ->
0BF76A                   	;                        X=0, Y+1), puis 0F2B6Ah (Y >= lcd_height -> defilement
0BF76A                   	;                        de la ROM, Y = lcd_height-1), puis l'affichage ;
0BF76A                   	;    0Dh               : 0F2B6Ah seul ;
0BF76A                   	;    08 09 0A 0B 1C 1D 1F : 0F2B57h puis 0F2B6Ah ;
0BF76A                   	;    07 0C 1E et le reste : pas de 0F2B6Ah.
0BF76A                   	; Le filtre calcule la ligne que verra 0F2B6Ah. Si la ROM allait defiler, il
0BF76A                   	; defile LUI-MEME les lignes debut .. lcd_height-1 (55h pattern_read, 56h
0BF76A                   	; pattern_write, 49h clear_line), puis remonte Y pour que la ROM ne defile plus.
0BF76A                   	; L'octet est ensuite transmis tel quel : le pilote fait tout le reste.
0BF76A                   	;
0BF76A                   	; ⚠️ SEULS LES ECRITURES DU HANDLE 0 SONT VUES. Un OPEN "SCRN:" ouvre un autre
0BF76A                   	;    handle, qui garde l'adresse de la ROM.
0BF76A                   	; ⚠️ NE PAS RECHARGER LE MODULE FILTRE BRANCHE. Entre LOAD M et CALL &BF000, le
0BF76A                   	;    handle 0 designerait du code ecrase. Faire XCONSOLE avant de recharger ;
0BF76A                   	;    CALL &BF000 debranche ensuite tout filtre reste dans la zone du module.
0BF76A                   	
0BF76A                   	; xf_entry -- l'entree du filtre : memes registres qu'une entree de pilote.
0BF76A                   	xf_entry:
0BF76A 2A                	        pushu   ba
0BF76B FD 23             	        mv      ba,i
0BF76D 60 0D             	        cmp     a,00DH                  ; write_byte
0BF76F 18 09             	        jrz     xf_wbyte
0BF771 60 0B             	        cmp     a,00BH                  ; write_block
0BF773 18 13             	        jrz     xf_wblock
0BF775 3A                	        popu    ba
0BF776                   	xf_pass:
0BF776 03 E7 21 0F       	        jpf     0F21E7H                 ; OPERANDE REECRIT par xf_on
0BF77A                   	xf_wbyte:
0BF77A 3A                	        popu    ba                      ; A = l'octet, I = 0Dh
0BF77B 2C                	        pushu   x
0BF77C 2D                	        pushu   y
0BF77D 2B                	        pushu   i
0BF77E 2A                	        pushu   ba
0BF77F 04 AC F7          	        call    xf_pre
0BF782 3A                	        popu    ba
0BF783 3B                	        popu    i
0BF784 3D                	        popu    y
0BF785 3C                	        popu    x
0BF786 13 12             	        jr      xf_pass
0BF788                   	
0BF788                   	; write_block : X = source, Y = compte. On le rend octet par octet au pilote,
0BF788                   	; chacun precede de son controle ; Y est rendu tel quel, comme 0F2A18h.
0BF788                   	xf_wblock:
0BF788 3A                	        popu    ba
0BF789 2D                	        pushu   y
0BF78A                   	xb_lp:
0BF78A 6C 05             	        inc     y
0BF78C 7C 05             	        dec     y
0BF78E 18 14             	        jrz     xb_end
0BF790 90 24             	        mv      a,[x++]
0BF792 2C                	        pushu   x
0BF793 2D                	        pushu   y
0BF794 28                	        pushu   a
0BF795 04 AC F7          	        call    xf_pre
0BF798 38                	        popu    a
0BF799 09 0D             	        mv      il,00DH
0BF79B 04 A7 F7          	        call    xf_call                 ; write_byte de l'ancien pilote
0BF79E 3D                	        popu    y
0BF79F 3C                	        popu    x
0BF7A0 7C 05             	        dec     y
0BF7A2 13 1A             	        jr      xb_lp
0BF7A4                   	xb_end:
0BF7A4 3D                	        popu    y
0BF7A5 9F                	        rc
0BF7A6 07                	        retf
0BF7A7                   	
0BF7A7                   	; xf_call -- appelle l'ancien pilote, commande dans IL.  APPEL PROCHE.
0BF7A7                   	xf_call:
0BF7A7 05 E7 21 0F       	        callf   0F21E7H                 ; OPERANDE REECRIT par xf_on
0BF7AB 06                	        ret
0BF7AC                   	
0BF7AC                   	; xf_pre -- A = l'octet a ecrire. Defile la fenetre si la ROM allait le faire.
0BF7AC                   	;           Detruit A, I, X, Y, (bl), (bh).  APPEL PROCHE.
0BF7AC                   	xf_pre:
0BF7AC 30 A0 D4          	        mv      (bl),a                  ; l'octet, le temps de le classer
0BF7AF 88 9B F9 0B       	        mv      a,[!xc_top]
0BF7B3 60 00             	        cmp     a,000H
0BF7B5 18 6E             	        jrz     xp_none                 ; debut 0 : la ROM suffit
0BF7B7 30 A0 D5          	        mv      (bh),a
0BF7BA 88 9E FC 0B       	        mv      a,[lcd_height]
0BF7BE 30 63 D5          	        cmp     (bh),a                  ; debut - hauteur : NC = pas de fenetre
0BF7C1 1E 62             	        jrnc    xp_none
0BF7C3 30 80 D4          	        mv      a,(bl)
0BF7C6 60 20             	        cmp     a,020H
0BF7C8 1E 1B             	        jrnc    xp_wrap                 ; affichable
0BF7CA 66 29 FC 0B 40    	        test    [ctrl_disp],040H
0BF7CF 1A 14             	        jrnz    xp_wrap                 ; code de controle affiche (0F2A56h)
0BF7D1 60 0D             	        cmp     a,00DH
0BF7D3 18 25             	        jrz     xp_nw                   ; CR : 0F2B6Ah sans 0F2B57h
0BF7D5 60 08             	        cmp     a,008H
0BF7D7 1C 4C             	        jrc     xp_none                 ; 00-07
0BF7D9 60 0C             	        cmp     a,00CH
0BF7DB 1C 08             	        jrc     xp_wrap                 ; 08 09 0A 0B
0BF7DD 60 1C             	        cmp     a,01CH
0BF7DF 1C 44             	        jrc     xp_none                 ; 0C-1B
0BF7E1 60 1E             	        cmp     a,01EH
0BF7E3 18 40             	        jrz     xp_none                 ; 1E, curseur vers le haut
0BF7E5                   	xp_wrap:                                ; 1C 1D 1F et les affichables
0BF7E5 09 00             	        mv      il,000H
0BF7E7 30 D0 D4 27 FC 0B 	        mv      (bl),[scrn_crsr_x]
0BF7ED 88 9D FC 0B       	        mv      a,[lcd_width]
0BF7F1 30 63 D4          	        cmp     (bl),a                  ; X - largeur : NC = retour differe
0BF7F4 1C 06             	        jrc     xp_chk
0BF7F6 09 01             	        mv      il,001H
0BF7F8 12 02             	        jr      xp_chk
0BF7FA                   	xp_nw:
0BF7FA 09 00             	        mv      il,000H
0BF7FC                   	xp_chk:
0BF7FC 88 28 FC 0B       	        mv      a,[scrn_crsr_y]
0BF800 46 01             	        add     a,il                    ; la ligne que verra 0F2B6Ah
0BF802 30 A0 D5          	        mv      (bh),a
0BF805 88 9E FC 0B       	        mv      a,[lcd_height]
0BF809 30 63 D5          	        cmp     (bh),a                  ; NC : la ROM defilerait
0BF80C 1C 17             	        jrc     xp_none
0BF80E A9 9D F9 0B       	        mv      [!xf_w],il
0BF812 04 26 F8          	        call    xf_scroll
0BF815 88 9E FC 0B       	        mv      a,[lcd_height]
0BF819 7C 00             	        dec     a
0BF81B 89 9D F9 0B       	        mv      il,[!xf_w]
0BF81F 4E 01             	        sub     a,il                    ; lcd_height-1-retour : plus de defilement ROM
0BF821 A8 28 FC 0B       	        mv      [scrn_crsr_y],a
0BF825                   	xp_none:
0BF825 06                	        ret
0BF826                   	
0BF826                   	; xf_scroll -- remonte d'une ligne les lignes debut+1 .. lcd_height-1, puis
0BF826                   	;              efface la derniere.  APPEL PROCHE.
0BF826                   	xf_scroll:
0BF826 88 9B F9 0B       	        mv      a,[!xc_top]
0BF82A A8 9E F9 0B       	        mv      [!xf_y],a
0BF82E                   	xs_lp:
0BF82E 88 9E F9 0B       	        mv      a,[!xf_y]
0BF832 6C 00             	        inc     a
0BF834 30 A0 D5          	        mv      (bh),a                  ; la ligne du dessous
0BF837 88 9E FC 0B       	        mv      a,[lcd_height]
0BF83B 30 63 D5          	        cmp     (bh),a
0BF83E 1E 25             	        jrnc    xs_clr                  ; plus rien a remonter
0BF840 0C 9F F9 0B       	        mv      x,xf_buf
0BF844 09 55             	        mv      il,d0_pattern_read
0BF846 04 A7 F7          	        call    xf_call
0BF849 88 9E F9 0B       	        mv      a,[!xf_y]
0BF84D 30 A0 D5          	        mv      (bh),a
0BF850 0C 9F F9 0B       	        mv      x,xf_buf
0BF854 09 56             	        mv      il,d0_pattern_write
0BF856 04 A7 F7          	        call    xf_call
0BF859 88 9E F9 0B       	        mv      a,[!xf_y]
0BF85D 6C 00             	        inc     a
0BF85F A8 9E F9 0B       	        mv      [!xf_y],a
0BF863 13 37             	        jr      xs_lp
0BF865                   	xs_clr:
0BF865 88 9E FC 0B       	        mv      a,[lcd_height]
0BF869 7C 00             	        dec     a
0BF86B 30 A0 D5          	        mv      (bh),a
0BF86E 09 49             	        mv      il,d0_clear_line
0BF870 04 A7 F7          	        call    xf_call
0BF873 06                	        ret
0BF874                   	
0BF874                   	; xf_fcb -- X = le bloc de controle du handle 0 ; CY=1 s'il n'est pas l'ecran.
0BF874                   	;           Detruit A, I, (bl).  APPEL PROCHE.
0BF874                   	xf_fcb:
0BF874 88 6D FC 0B       	        mv      a,[fhandle]             ; handle 0 -> numero de bloc
0BF878 30 A0 D4          	        mv      (bl),a
0BF87B 30 84 E6          	        mv      x,(iocsw)
0BF87E 90 84 27          	        mv      a,[x+027H]              ; nombre de blocs
0BF881 30 63 D4          	        cmp     (bl),a
0BF884 1E 1E             	        jrnc    xfc_no
0BF886 93 84 25          	        mv      i,[x+025H]
0BF889 45 43             	        add     x,i                     ; le premier bloc
0BF88B 0B 1F 00          	        mv      i,0001FH                ; 31 octets par bloc
0BF88E                   	xfc_lp:
0BF88E 30 80 D4          	        mv      a,(bl)
0BF891 60 00             	        cmp     a,000H
0BF893 18 07             	        jrz     xfc_at
0BF895 45 43             	        add     x,i
0BF897 30 7D D4          	        dec     (bl)
0BF89A 13 0E             	        jr      xfc_lp
0BF89C                   	xfc_at:
0BF89C 90 04             	        mv      a,[x]                   ; le device du bloc
0BF89E 60 00             	        cmp     a,000H
0BF8A0 1A 02             	        jrnz    xfc_no                  ; libre (0FFh) ou pas l'ecran
0BF8A2 9F                	        rc
0BF8A3 06                	        ret
0BF8A4                   	xfc_no:
0BF8A4 97                	        sc
0BF8A5 06                	        ret
0BF8A6                   	
0BF8A6                   	; xf_on -- branche le filtre sur le handle 0.  APPEL PROCHE.
0BF8A6                   	;          Deja branche (adresse dans la zone du module) : ne rien faire, sans
0BF8A6                   	;          quoi le filtre se transmettrait a lui-meme.
0BF8A6                   	;
0BF8A6                   	;    ⛔ DANS LE PILOTE (BASEXT-DRV), LA PLAGE 0BF000h-0BFFFFh NE DIT RIEN : le
0BF8A6                   	;       bloc reside ailleurs dans S1:, et un « deja nous » par plage laisserait
0BF8A6                   	;       le filtre se brancher sur lui-meme au second XCONSOLE (recursion sans
0BF8A6                   	;       fin). Le pilote compare donc l'adresse en place a xf_entry, exactement.
0BF8A6                   	;       Ces octets de plage ne sont pas des champs d'adresse : la mesure de
0BF8A6                   	;       relocation (reloc.py) ne pouvait pas les voir. Releve a la lecture le
0BF8A6                   	;       2026-09-16. Le module autonome garde son test, eprouve sur machine.
0BF8A6                   	xf_on:
0BF8A6 04 74 F8          	        call    xf_fcb
0BF8A9 1C 20             	        jrc     xon_ret
0BF8AB 90 84 04          	        mv      a,[x+004H]
0BF8AE 60 0B             	        cmp     a,00BH
0BF8B0 1A 07             	        jrnz    xon_set
0BF8B2 90 84 03          	        mv      a,[x+003H]
0BF8B5 60 F0             	        cmp     a,0F0H
0BF8B7 1E 12             	        jrnc    xon_ret                 ; 0BF000h-0BFFFFh : deja nous
0BF8B9                   	xon_set:
0BF8B9 95 84 02          	        mv      y,[x+002H]              ; l'adresse en place : la ROM, ou un autre
0BF8BC AD 77 F7 0B       	        mv      [!xf_pass+1],y
0BF8C0 AD A8 F7 0B       	        mv      [!xf_call+1],y
0BF8C4 0D 6A F7 0B       	        mv      y,xf_entry
0BF8C8 B5 84 02          	        mv      [x+002H],y              ; une seule instruction : atomique
0BF8CB                   	xon_ret:
0BF8CB 06                	        ret
0BF8CC                   	
0BF8CC                   	; xf_off -- debranche le filtre : rend l'adresse gardee dans xf_pass. Apres un
0BF8CC                   	;           rechargement du module, c'est celle de l'assemblage, 0F21E7h.
0BF8CC                   	;           APPEL PROCHE.
0BF8CC                   	xf_off:
0BF8CC 04 74 F8          	        call    xf_fcb
0BF8CF 1C 15             	        jrc     xof_ret
0BF8D1 90 84 04          	        mv      a,[x+004H]
0BF8D4 60 0B             	        cmp     a,00BH
0BF8D6 1A 0E             	        jrnz    xof_ret
0BF8D8 90 84 03          	        mv      a,[x+003H]
0BF8DB 60 F0             	        cmp     a,0F0H
0BF8DD 1C 07             	        jrc     xof_ret                 ; pas un filtre de la zone du module
0BF8DF 8D 77 F7 0B       	        mv      y,[!xf_pass+1]
0BF8E3 B5 84 02          	        mv      [x+002H],y
0BF8E6                   	xof_ret:
0BF8E6 06                	        ret
0BF8E7                   	
0BF8E7                   	
0BF8E7                   	; ============================================================================
0BF8E7                   	; LES QUATRE ENTREES
0BF8E7                   	; ============================================================================
0BF8E7                   	kw_table:
0BF8E7 05 4C 50 45 45 4B 	        db      5,'LPEEK',tk_lp
0BF8ED 07                	
0BF8EE 05 57 50 45 45 4B 	        db      5,'WPEEK',tk_wp
0BF8F4 0A                	
0BF8F5 05 4C 50 4F 4B 45 	        db      5,'LPOKE',tk_lpo
0BF8FB 0E                	
0BF8FC 03 4D 4F 44 0F    	        db      3,'MOD',tk_mod
0BF901 06 55 43 41 53 45 	        db      6,'UCASE$',tk_uc
0BF907 24 C6             	
0BF909 06 4C 43 41 53 45 	        db      6,'LCASE$',tk_lc
0BF90F 24 C7             	
0BF911 05 54 52 49 4D 24 	        db      5,'TRIM$',tk_tr
0BF917 C3                	
0BF918 06 4C 54 52 49 4D 	        db      6,'LTRIM$',tk_lt
0BF91E 24 C4             	
0BF920 06 52 54 52 49 4D 	        db      6,'RTRIM$',tk_rt
0BF926 24 C5             	
0BF928 05 52 45 50 54 24 	        db      5,'REPT$',tk_rp
0BF92E C8                	
0BF92F 06 53 52 45 50 54 	        db      6,'SREPT$',tk_sr
0BF935 24 C9             	
0BF937 05 49 4E 53 54 52 	        db      5,'INSTR',tk_in
0BF93D C2                	
0BF93E 08 58 43 4F 4E 53 	        db      8,'XCONSOLE',tk_xc
0BF944 4F 4C 45 CA       	
0BF948 04 58 43 4C 53 CF 	        db      4,'XCLS',tk_xcl
0BF94E 00                	        db      0                       ; fin de table
0BF94F                   	
0BF94F                   	disp_table:
0BF94F                   	; Trois entrees de 4 octets, puis le terminateur. Le quartet haut du 3e octet
0BF94F                   	; d'adresse est un DRAPEAU : 040h = fonction, routine a l'adresse + 3 ; 080h =
0BF94F                   	; instruction, routine a l'adresse telle quelle. LPOKE est du second genre, et
0BF94F                   	; n'a donc pas de prefixe de trois octets.
0BF94F 07                	        db      tk_lp
0BF950 2F                	        db      lpeek_m3
0BF951 F0                	        db      lpeek_m3/256
0BF952 4B                	        db      lpeek_m3/65536+040H
0BF953 0A                	        db      tk_wp
0BF954 71                	        db      wpeek_m3
0BF955 F0                	        db      wpeek_m3/256
0BF956 4B                	        db      wpeek_m3/65536+040H
0BF957 0E                	        db      tk_lpo
0BF958 A7                	        db      lpoke
0BF959 F0                	        db      lpoke/256
0BF95A 8B                	        db      lpoke/65536+080H
0BF95B 0F                	        db      tk_mod
0BF95C 03                	        db      modu_m3
0BF95D F1                	        db      modu_m3/256
0BF95E 4B                	        db      modu_m3/65536+040H
0BF95F C6 26 F2 4B       	        db      tk_uc, ucase_m3, ucase_m3/256, ucase_m3/65536+040H
0BF963 C7 51 F2 4B       	        db      tk_lc, lcase_m3, lcase_m3/256, lcase_m3/65536+040H
0BF967 C3 7C F2 4B       	        db      tk_tr, trim_m3,  trim_m3/256,  trim_m3/65536+040H
0BF96B C4 83 F2 4B       	        db      tk_lt, ltrim_m3, ltrim_m3/256, ltrim_m3/65536+040H
0BF96F C5 8A F2 4B       	        db      tk_rt, rtrim_m3, rtrim_m3/256, rtrim_m3/65536+040H
0BF973 C8 15 F3 4B       	        db      tk_rp, rept_m3,  rept_m3/256,  rept_m3/65536+040H
0BF977 C9 FA F3 4B       	        db      tk_sr, srept_m3, srept_m3/256, srept_m3/65536+040H
0BF97B C2 08 F5 4B       	        db      tk_in, instr_m3, instr_m3/256, instr_m3/65536+040H
0BF97F CA 2F F6 8B       	        db      tk_xc,  xconsole, xconsole/256, xconsole/65536+080H   ; instructions :
