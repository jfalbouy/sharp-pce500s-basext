0BF103                   	
0BF103                   	; ============================================================================
0BF103                   	; LA FONCTION MOD (A,B) -- le reste de la division entiere
0BF103                   	; ============================================================================
0BF103                   	; L'interpreteur y saute a modu_m3 + 3 : c'est une FONCTION (drapeau 040h).
0BF103                   	;
0BF103                   	;   PRINT MOD (17,5)      2
0BF103                   	;   R = MOD (A,B)
0BF103                   	;
0BF103                   	; ⛔ PAS D'INFIXE POSSIBLE. « A MOD B » est hors d'atteinte : la reconnaissance
0BF103                   	;    des operateurs est CABLEE EN DUR dans l'analyseur d'expression, en 0EF2C5h,
0BF103                   	;    par trois comparaisons litterales contre 0A1h (AND), 0A2h (OR) et 0A5h
0BF103                   	;    (XOR) -- ni table, ni plage, et nos deux crochets n'y donnent pas acces.
0BF103                   	;    La syntaxe est donc celle de POINT (x,y), que la machine possede deja.
0BF103                   	;
0BF103                   	; ⛔ ET LE CALCUL N'EMPRUNTE RIEN A LA BIBLIOTHEQUE FLOTTANTE DE LA ROM. Deux
0BF103                   	;    versions ont essaye de calculer A - B * INT (A/B) par les commandes du
0BF103                   	;    device 9 ; les deux ont plante la machine (CLS puis MENU principal), et la
0BF103                   	;    seconde alors meme que ses cinq adresses etaient JUSTES -- verifiees une a
0BF103                   	;    une dans la table de repartition DB_EF078 du driver drv_function :
0BF103                   	;
0BF103                   	;      047h add 0ECBA9h   048h sub 0ECBB4h   049h mul 0ECBBFh
0BF103                   	;      04Ah div 0ECBD8h   056h int 0EE4D5h
0BF103                   	;
0BF103                   	;    Ce que ces adresses ne disent pas, c'est le CONTRAT. Il y a deux diviseurs
0BF103                   	;    (SUB_ECCEA et SUB_ECD85), l'entree 04Ah ne mene qu'au second, et le seul
0BF103                   	;    appelant connu de la ROM -- l'evaluateur d'expression en 0E8559h -- fait
0BF103                   	;    « mv i,0000Fh / exl (000h),(00Fh) » AVANT d'appeler : il ECHANGE X et Y,
0BF103                   	;    ce que ne fait aucune des trois autres operations.
0BF103                   	;
0BF103                   	;    Le calcul est donc fait ici, en binaire, et ne s'appuie que sur des
0BF103                   	;    primitives EPROUVEES SUR LA MACHINE par LPEEK et LPOKE : chknum, dec2bin,
0BF103                   	;    bin2dec.
0BF103                   	;
0BF103                   	; ⛔ ET ON NE SUPPOSE RIEN DE CE QUE chknum FAIT DE BP. Une premiere version
0BF103                   	;    binaire tenait pour acquis qu'un chknum EMPILE un cadre de 15 octets, donc
0BF103                   	;    qu'apres le second appel le premier operande se lisait en (bp+16)..(bp+18).
0BF103                   	;    Je l'avais deduit d'un enchainement de la ROM en 0ECBCAh -- une inference,
0BF103                   	;    pas une mesure. LA MACHINE L'A DEMENTIE : elle rendait 0 pour toutes les
0BF103                   	;    valeurs, ce qui est la signature d'un A perdu (0 mod B, ou B mod B).
0BF103                   	;
0BF103                   	;    Plutot que de deviner une troisieme fois la taille et le sens du cadre,
0BF103                   	;    cette version REND LA QUESTION SANS OBJET :
0BF103                   	;      . le premier operande est mis a l'abri en RAM du module (sv_a) des que
0BF103                   	;        dec2bin l'a converti, donc avant que le second chknum ne puisse rien
0BF103                   	;        ecraser ;
0BF103                   	;      . BP est SAUVE et RESTAURE en absolu (sv_bp0, sv_bp1) au lieu d'etre
0BF103                   	;        rattrape par des pmdf comptes a la main.
0BF103                   	;    Le module se comporte alors exactement comme LPEEK, qui lui fonctionne :
0BF103                   	;    resultat en (bp+0)..(bp+3), BP tel qu'il etait apres LE PREMIER chknum.
0BF103                   	;    Que chknum empile 15 octets, 8, ou rien du tout, le resultat est le meme.
0BF103                   	;
0BF103                   	; LE DOMAINE : A et B sont des ENTIERS de 0 a 1048575, celui de LPEEK et de
0BF103                   	; LPOKE. La borne n'est pas un choix mais une mesure : dec2bin accumule dans X,
0BF103                   	; registre de 20 bits, et REFUSE lui-meme au-dela (« add x,a / jrc » en
0BF103                   	; 0EFAFBh, puis erreur 33) -- c'est donc la ROM, et non nous, qui signale un
0BF103                   	; operande trop grand. Un operande negatif est refuse ici : dec2bin en rend la
0BF103                   	; valeur absolue en laissant le signe dans le bit 3 de (bp+0), donc l'ignorer
0BF103                   	; rendrait un resultat faux en silence. Le reste etant toujours < B, il tient
0BF103                   	; toujours dans les 20 bits que bin2dec sait reconvertir.
0BF103                   	
0BF103                   	modu_m3:
0BF103 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BF106                   	
0BF106                   	modu:
0BF106                   	; ⛔ LES PARENTHESES SONT OBLIGATOIRES, ET C'EST LA ROM QUI LE DIT.
0BF106                   	;    SUB_FD5E7, le lecteur d'arguments de POINT (x,y), exige TROIS caracteres :
0BF106                   	;    '(' en 0FD5ECh, ',' en 0FD5F9h et ')' en 0FD60Ah. Une premiere version de
0BF106                   	;    cette fonction n'en verifiait qu'un : chknum recevait (17,5) tout entier et
0BF106                   	;    tentait d'evaluer une expression parenthesee. PRINT MOD(17,5) repondait
0BF106                   	;    Syntax error. Constate sur emulateur, corrige en relisant SUB_FD5E7.
0BF106                   	md_sp:
0BF106 90 24             	        mv      a,[x++]
0BF108 60 20             	        cmp     a,020H          ; sauter les espaces -- ce que fait SUB_FB2D9
0BF10A 19 06             	        jrz     md_sp
0BF10C 60 28             	        cmp     a,028H          ; '(' obligatoire
0BF10E 1A 98             	        jrnz    md_syn0
0BF110                   	
0BF110                   	; BP a l'entree : l'etat a rendre si l'on doit signaler une erreur, puisque
0BF110                   	; c'est celui d'avant tout ce que nous avons pu prendre.
0BF110 30 D8 8B F9 0B EC 	        mv      [!sv_bp0],(bp_ram)
0BF116                   	
0BF116                   	; --- A, le dividende --------------------------------------------------------
0BF116 05 6E F2 0E       	        callf   eval            ; expression complete -> (bp+0)
0BF11A 1C 8B             	        jrc     md_ret          ; echec : rien n'a ete pris
0BF11C 65 00 80          	        test    (BP+0),080H     ; bit 7 : c'est une chaine
0BF11F 1A 9F             	        jrnz    md_type
0BF121                   	
0BF121                   	; ⛔ BP D'APRES LA PREMIERE EVALUATION, SAUVE EN ABSOLU. Le cadre pousse par
0BF121                   	;    chknum vaut 15 octets, MESURE sur machine (BP 150 -> 135). Celui d'eval
0BF121                   	;    ne l'est PAS : je ne le suppose donc pas, et je restaure BP par sa valeur
0BF121                   	;    plutot que par un pmdf compte a la main. sv_bp0 et sv_bp1 etant tous deux
0BF121                   	;    lisibles depuis le BASIC, l'ecart se mesurera au prochain essai.
0BF121 30 D8 8C F9 0B EC 	        mv      [!sv_bp1],(bp_ram)
0BF127                   	
0BF127 05 D4 FA 0E       	        callf   dec2bin         ; A -> entier 20 bits en (bp+1)..(bp+3)
0BF12B 1C 7A             	        jrc     md_ret
0BF12D 65 00 08          	        test    (BP+0),008H     ; bit 3 : le signe
0BF130 1A 98             	        jrnz    md_neg
0BF132                   	
0BF132                   	; ⛔ A EST MIS A L'ABRI ICI, ET C'EST TOUT L'INTERET DE CETTE VERSION. Le second
0BF132                   	;    chknum ecrit sa valeur en (bp+0), et rien ne garantit qu'il ait d'abord
0BF132                   	;    decale le cadre : la version precedente l'a suppose et perdait A.
0BF132 DA 88 F9 0B 01    	        mvp     [!sv_a],(BP+1)
0BF137                   	
0BF137 90 24             	        mv      a,[x++]
0BF139 60 2C             	        cmp     a,02CH          ; ',' obligatoire : il faut DEUX arguments
0BF13B 1A 79             	        jrnz    md_syn
0BF13D                   	
0BF13D                   	; --- B, le diviseur ---------------------------------------------------------
0BF13D 05 6E F2 0E       	        callf   eval            ; expression complete -> (bp+0)
0BF141 1C 6B             	        jrc     md_bad
0BF143 65 00 80          	        test    (BP+0),080H     ; bit 7 : c'est une chaine
0BF146 1A 78             	        jrnz    md_type
0BF148 05 D4 FA 0E       	        callf   dec2bin         ; B -> entier 20 bits en (bp+1)..(bp+3)
0BF14C 1C 60             	        jrc     md_bad
0BF14E 65 00 08          	        test    (BP+0),008H
0BF151 1A 77             	        jrnz    md_neg
0BF153                   	
0BF153 90 24             	        mv      a,[x++]
0BF155 60 29             	        cmp     a,029H          ; ')' obligatoire
0BF157 1A 5D             	        jrnz    md_syn
0BF159                   	
0BF159                   	; --- B = 0 : erreur 21, celle que la ROM emploie pour le meme cas (0ECD67h) --
0BF159 80 01             	        mv      a,(BP+1)
0BF15B 7F 02             	        or      a,(BP+2)
0BF15D 7F 03             	        or      a,(BP+3)
0BF15F 18 73             	        jrz     md_zero
0BF161                   	
0BF161 2C                	        pushu   x               ; le point de reprise de l'interpreteur
0BF162                   	
0BF162                   	; ============================================================================
0BF162                   	; LA DIVISION BINAIRE A RESTAURATION -- 24 tours, tout en RAM interne
0BF162                   	; ============================================================================
0BF162                   	; Tout tient dans la QUEUE du cadre courant, (bp+4) a (bp+14), dont dec2bin n'a
0BF162                   	; plus l'usage. C'est de la RAM interne, donc rapide, et cela reste valable quel
0BF162                   	; que soit le cadre ou nous sommes.
0BF162                   	;
0BF162                   	;   A    : (bp+4),(bp+5),(bp+6)     relu de sv_a ; consomme par le decalage --
0BF162                   	;                                   le quotient est jete, MOD n'en veut pas
0BF162                   	;   cnt  : (bp+7)                   le compteur de tours
0BF162                   	;   rst  : (bp+8),(bp+9),(bp+10)    le reste en construction
0BF162                   	;   tmp  : (bp+12),(bp+13),(bp+14)  rst - B, garde s'il n'y a pas d'emprunt
0BF162                   	;   B    : (bp+1),(bp+2),(bp+3)     la ou dec2bin vient de le mettre
0BF162                   	;
0BF162                   	; ⛔ SHL, ET SURTOUT PAS ROL -- C'EST LA QUE MOD RENDAIT 0 POUR TOUT.
0BF162                   	;    Sur ce processeur, ROL/ROR sont CIRCULAIRES dans l'octet : la retenue recoit
0BF162                   	;    bien le bit sortant, mais ce bit revient aussi en bas du MEME octet, et rien
0BF162                   	;    ne passe a l'octet suivant. Une premiere version decalait A avec six « rol » :
0BF162                   	;    chaque octet tournait sur lui-meme, le reste ne recevait jamais aucun bit et
0BF162                   	;    valait donc 0 -- pour toutes les valeurs, ce qu'a montre la machine.
0BF162                   	;
0BF162                   	;    LA ROM TRANCHE, ET DANS LES DEUX SENS :
0BF162                   	;      . elle CHAINE « shr » sur des octets consecutifs -- « F5 12 F5 13 F5 14
0BF162                   	;        F5 15 F5 16 » en 0EEBB8h, un decalage de cinq octets. Seul un decalage
0BF162                   	;        A TRAVERS la retenue peut se chainer ainsi ;
0BF162                   	;      . et elle emploie « ror » la ou il faut LIRE les bits sans detruire
0BF162                   	;        l'octet : bin2dec fait « ror (00Bh) / jrnc » huit fois par octet
0BF162                   	;        (0EFBA3h), et huit rotations circulaires le rendent intact.
0BF162                   	;    Les deux usages sont coherents, et ils s'excluent.
0BF162                   	;
0BF162                   	; 📄 Notre propre reference (SC62015_InstructionSet_Reference.md) decrit ROL et
0BF162                   	;    SHL de la MEME facon, « via C » -- ce qui ne peut pas etre vrai des deux.
0BF162                   	;    A corriger la-bas : la ROM est l'arbitre.
0BF162                   	;
0BF162                   	; ⛔ ET CES DECALAGES NE CONSULTENT PAS I. bin2dec enchaine « ror (00Bh) / jrnc »
0BF162                   	;    alors que IL vaut encore 4 d'un dadl precedent, et n'en rotationne qu'un
0BF162                   	;    octet. Les instructions BLOC, elles, bouclent I fois -- « mv il,00Fh /
0BF162                   	;    mvl (000h),(00Fh) » de la ROM recopie bien 15 octets.
0BF162                   	md_calc:
0BF162 D2 04 88 F9 0B    	        mvp     (BP+4),[!sv_a]  ; A, revenu de l'abri
0BF167 DC 08 00 00 00    	        mvp     (BP+8),000000H  ; reste = 0
0BF16C CC 07 18          	        mv      (BP+7),00024    ; 24 tours : la largeur de A
0BF16F                   	md_loop:
0BF16F 9F                	        rc
0BF170 F7 04             	        shl     (BP+4)          ; A <<= 1 ; le bit sortant part dans la retenue
0BF172 F7 05             	        shl     (BP+5)
0BF174 F7 06             	        shl     (BP+6)
0BF176 F7 08             	        shl     (BP+8)          ; reste = reste<<1 | ce bit
0BF178 F7 09             	        shl     (BP+9)
0BF17A F7 0A             	        shl     (BP+10)
0BF17C                   	
0BF17C CA 0C 08          	        mvp     (BP+12),(BP+8)  ; tmp = reste
0BF17F 9F                	        rc                      ; SBCL retranche AUSSI la retenue : la vider
0BF180 09 03             	        mv      il,003
0BF182 5C 0C 01          	        sbcl    (BP+12),(BP+1)  ; tmp = reste - B, sur trois octets
0BF185 1C 03             	        jrc     md_next         ; emprunt : reste < B, on ne retranche pas
0BF187 CA 08 0C          	        mvp     (BP+8),(BP+12)  ; sinon le reste devient tmp
0BF18A                   	md_next:
0BF18A 7D 07             	        dec     (BP+7)
0BF18C 1B 1F             	        jrnz    md_loop
0BF18E                   	
0BF18E                   	; --- rendre le reste exactement comme LPEEK rend le sien --------------------
0BF18E                   	; ⛔ LE DECALAGE DE chknum EST DESORMAIS MESURE, ET NON SUPPOSE. Le module a
0BF18E                   	;    laisse BP en RAM avant et apres son premier chknum ; releve sur la machine :
0BF18E                   	;    96h puis 87h, soit QUINZE octets tout rond. Le cadre du resultat est donc
0BF18E                   	;    celui d'un pmdf +15, et sv_a n'a plus a servir de pont -- ce qui le laisse
0BF18E                   	;    porter A, donc mesurable a son tour.
0BF18E                   	; sv_a a rendu A a la boucle : il sert maintenant de pont vers l'autre cadre.
0BF18E DA 88 F9 0B 08    	        mvp     [!sv_a],(BP+8)          ; le reste, le temps de changer de cadre
