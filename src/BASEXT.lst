0BF0A8 1C 42             	        jrc     lp_ret          ; chknum a echoue : il n'a pas pris de cadre
0BF0AA 05 D4 FA 0E       	        callf   dec2bin
0BF0AE 1C 3C             	        jrc     lp_ret
0BF0B0 80 00             	        mv      a,(BP+0)        ; bit 3 = signe
0BF0B2 64 08             	        test    a,008H
0BF0B4 1A 37             	        jrnz    lp_syn
0BF0B6 80 03             	        mv      a,(BP+3)
0BF0B8 60 10             	        cmp     a,010H
0BF0BA 1E 31             	        jrnc    lp_syn          ; au-dela de 0FFFFFh
0BF0BC 85 01             	        mv      y,(BP+1)        ; Y = la destination
0BF0BE 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; rendre le cadre de la destination
0BF0C2                   	
0BF0C2                   	lp_next:
0BF0C2 90 24             	        mv      a,[x++]
0BF0C4 60 2C             	        cmp     a,02CH          ; ','
0BF0C6 1A 21             	        jrnz    lp_done         ; plus de virgule : c'est fini
0BF0C8 2D                	        pushu   y               ; la destination, que chknum n'a pas a connaitre
0BF0C9 05 F3 FB 0E       	        callf   chknum          ; la valeur
0BF0CD 1C 26             	        jrc     lp_pop
0BF0CF 05 D4 FA 0E       	        callf   dec2bin
0BF0D3 1C 20             	        jrc     lp_pop
0BF0D5 80 00             	        mv      a,(BP+0)
0BF0D7 64 08             	        test    a,008H
0BF0D9 1A 1C             	        jrnz    lp_popsyn       ; valeur negative
0BF0DB 3D                	        popu    y
0BF0DC EA 05 01          	        mvp     [y],(BP+1)      ; les TROIS octets, petit-boutien
0BF0DF 08 03             	        mv      a,003H
0BF0E1 45 50             	        add     y,a             ; adresse suivante
0BF0E3 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; rendre le cadre de la valeur
0BF0E7 13 27             	        jr      lp_next
