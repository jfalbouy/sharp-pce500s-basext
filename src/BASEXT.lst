0BF62F                   	
0BF62F                   	; ============================================================================
0BF62F                   	; XCONSOLE [debut][,[nombre]]  --  la fenetre de la console (INSTRUCTION)
0BF62F                   	; ============================================================================
0BF62F                   	; Borne la console aux lignes debut .. debut+nombre-1 de l'ecran de 4 lignes.
0BF62F                   	;
0BF62F                   	;   XCONSOLE            0,4 : l'ecran entier, l'etat normal
0BF62F                   	;   XCONSOLE ,2         lignes 0-1 ; les lignes 2-3 restent figees
0BF62F                   	;   XCONSOLE 2          lignes 2-3 (le nombre omis va jusqu'en bas)
0BF62F                   	;   XCONSOLE 1,2        lignes 1-2
0BF62F                   	;
0BF62F                   	; Refus : debut > 3, nombre nul, ou debut+nombre > 4 -> erreur 33 ; une chaine
0BF62F                   	; -> erreur 90 ; un separateur autre que ',' -> erreur 10.
0BF62F                   	;
0BF62F                   	; LE LEVIER EST lcd_height (0BFC9Eh), ET NON LE CURSEUR 0BFC27h/0BFC28h.
0BF62F                   	;    Le pilote d'ecran defile quand (bh) atteint lcd_height (0F2B6Ah), clear_disp
0BF62F                   	;    n'efface que les lignes 0 .. lcd_height-1 (0F2771h), et LOCATE refuse un Y
0BF62F                   	;    au-dela (0FC682h). ✅ Mesure sur machine par J.-F. Albouy : POKE &BFC9E,2
0BF62F                   	;    confine affichage, defilement et CLS aux lignes 0-1, et CLS ne remet PAS la
0BF62F                   	;    hauteur a 4.
0BF62F                   	;
0BF62F                   	; POUR debut > 0, LA ROM NE SUFFIT PLUS : son defilement part TOUJOURS de la
0BF62F                   	;    ligne 0 (0F27F1h, recopie par 0F28E3h) et emporterait les lignes figees.
0BF62F                   	;    XCONSOLE branche alors le FILTRE D'ECRITURE (xf_entry, plus bas) sur le
0BF62F                   	;    handle 0, et l'en debranche quand debut revient a 0.
0BF62F                   	;
0BF62F                   	; ⛔ LA FENETRE SURVIT A LA FIN DU PROGRAMME. Mesure : l'invite du mode direct
0BF62F                   	;    reste dans les lignes de la fenetre, et seul MENU puis BASIC rend l'ecran.
0BF62F                   	;    Un programme doit donc finir par XCONSOLE (puis CLS) -- apres une erreur ou
0BF62F                   	;    un BREAK, MENU puis BASIC.
0BF62F                   	;
0BF62F                   	; ⚠️ CLS AVEC UNE FENETRE DE MOINS DE 4 LIGNES AFFICHE LES LIBELLES DES TOUCHES
0BF62F                   	;    DE FONCTION sur la ligne 3. C'est la ROM : CLS teste lcd_height (0F931Ah) et,
0BF62F                   	;    s'il ne vaut pas 4, appelle fkey_display (commande 46h du clavier, 0F1CFAh),
0BF62F                   	;    qui dessine les libelles par la commande 58h de l'ecran -- sans passer par le
0BF62F                   	;    filtre. Constate sur machine, et deja avec un simple POKE &BFC9E,2. Dans une
0BF62F                   	;    fenetre, effacer par XCLS ; pour tout effacer, XCONSOLE : CLS.
0BF62F                   	;
0BF62F                   	; La fin d'instruction est celle de 0F617Ch, que lisent CONSOLE et LOCATE :
0BF62F                   	; ':' ou 0Dh, regardes sans etre consommes. Les espaces se sautent comme en
0BF62F                   	; 0FB2D9h. BP est rendu en ABSOLU (sv_bp0) sur tous les chemins : une
0BF62F                   	; instruction rend BP inchange (MODE-EMPLOI §6.1).
0BF62F                   	xconsole:
0BF62F 30 D8 8B F9 0B EC 	        mv      [!sv_bp0],(bp_ram)      ; BP d'entree
0BF635 08 00             	        mv      a,000H
0BF637 A8 99 F9 0B       	        mv      [!xc_t],a               ; debut par defaut : 0
0BF63B 08 FF             	        mv      a,0FFH
0BF63D A8 9A F9 0B       	        mv      [!xc_c],a               ; nombre : absent
0BF641 04 D0 F6          	        call    xc_skip                 ; A = premier non-espace, X dessus
0BF644 60 3A             	        cmp     a,03AH                  ; ':'
0BF646 18 36             	        jrz     xc_apply
0BF648 60 0D             	        cmp     a,00DH                  ; fin de ligne
0BF64A 18 32             	        jrz     xc_apply                ; XCONSOLE seul
0BF64C 60 2C             	        cmp     a,02CH
0BF64E 18 18             	        jrz     xc_comma                ; XCONSOLE ,n : debut omis
0BF650 04 DB F6          	        call    xc_num                  ; le debut
0BF653 1C 73             	        jrc     xc_err
0BF655 A8 99 F9 0B       	        mv      [!xc_t],a
0BF659 04 D0 F6          	        call    xc_skip
0BF65C 60 3A             	        cmp     a,03AH
0BF65E 18 1E             	        jrz     xc_apply
0BF660 60 0D             	        cmp     a,00DH
0BF662 18 1A             	        jrz     xc_apply
0BF664 60 2C             	        cmp     a,02CH
0BF666 1A 5A             	        jrnz    xc_syn
0BF668                   	xc_comma:
0BF668 6C 04             	        inc     x                       ; consommer la virgule
0BF66A 04 D0 F6          	        call    xc_skip
0BF66D 60 3A             	        cmp     a,03AH
0BF66F 18 0D             	        jrz     xc_apply
0BF671 60 0D             	        cmp     a,00DH
0BF673 18 09             	        jrz     xc_apply                ; XCONSOLE d, : nombre omis
0BF675 04 DB F6          	        call    xc_num                  ; le nombre de lignes
0BF678 1C 4E             	        jrc     xc_err
0BF67A A8 9A F9 0B       	        mv      [!xc_c],a
0BF67E                   	
0BF67E                   	xc_apply:
0BF67E 88 99 F9 0B       	        mv      a,[!xc_t]
0BF682 60 04             	        cmp     a,004H
0BF684 1E 40             	        jrnc    xc_range                ; debut au-dela de la ligne 3
0BF686 FD 10             	        mv      il,a                    ; IL = debut
0BF688 88 9A F9 0B       	        mv      a,[!xc_c]
0BF68C 60 FF             	        cmp     a,0FFH
0BF68E 18 0E             	        jrz     xc_full                 ; nombre omis : jusqu'en bas
0BF690 60 00             	        cmp     a,000H
0BF692 18 32             	        jrz     xc_range                ; une fenetre de zero ligne
0BF694 46 01             	        add     a,il                    ; A = debut + nombre = la hauteur
0BF696 1C 2E             	        jrc     xc_range
0BF698 60 05             	        cmp     a,005H
0BF69A 1E 2A             	        jrnc    xc_range                ; deborde sous la ligne 3
0BF69C 12 02             	        jr      xc_store
0BF69E                   	xc_full:
0BF69E 08 04             	        mv      a,004H
0BF6A0                   	xc_store:
0BF6A0 A8 9E FC 0B       	        mv      [lcd_height],a
0BF6A4 A9 9B F9 0B       	        mv      [!xc_top],il            ; le debut, que XCLS et le filtre reliront
0BF6A8 2C                	        pushu   x                       ; xf_on et xf_off se servent de X et de I
0BF6A9 2B                	        pushu   i
0BF6AA FD 01             	        mv      a,il
0BF6AC 60 00             	        cmp     a,000H
0BF6AE 18 05             	        jrz     xc_unhook
0BF6B0 04 A6 F8          	        call    xf_on                   ; fenetre haute : le filtre est necessaire
0BF6B3 12 03             	        jr      xc_hooked
0BF6B5                   	xc_unhook:
0BF6B5 04 CC F8          	        call    xf_off                  ; debut 0 : la ROM suffit
0BF6B8                   	xc_hooked:
0BF6B8 3B                	        popu    i
0BF6B9 3C                	        popu    x
0BF6BA 30 D0 EC 8B F9 0B 	        mv      (bp_ram),[!sv_bp0]
0BF6C0 9F                	        rc
0BF6C1 07                	        retf
0BF6C2                   	
0BF6C2                   	xc_syn:
0BF6C2 08 0A             	        mv      a,err_syn
0BF6C4 12 02             	        jr      xc_err
0BF6C6                   	xc_range:
0BF6C6 08 21             	        mv      a,err_range
0BF6C8                   	xc_err:
0BF6C8 30 D0 EC 8B F9 0B 	        mv      (bp_ram),[!sv_bp0]
0BF6CE 97                	        sc
0BF6CF 07                	        retf
0BF6D0                   	
0BF6D0                   	; xc_skip -- saute les espaces ; X reste SUR le premier non-espace, rendu dans A.
0BF6D0                   	;            APPEL PROCHE.
0BF6D0                   	xc_skip:
0BF6D0 90 04             	        mv      a,[x]
