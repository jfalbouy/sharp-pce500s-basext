0BF0A7                   	
0BF0A7                   	; ============================================================================
0BF0A7                   	; L'INSTRUCTION LPOKE destination,valeur1,valeur2,...
0BF0A7                   	; ============================================================================
0BF0A7                   	; Ecrit chaque valeur sur TROIS octets, en ordre petit-boutien, a des adresses
0BF0A7                   	; consecutives :
0BF0A7                   	;
0BF0A7                   	;   LPOKE &BF000,&123456,&789ABC   met 56 34 12 en &BF000
0BF0A7                   	;                                  puis BC 9A 78 en &BF003
0BF0A7                   	;
0BF0A7                   	; C'est le pendant de LPEEK, et il comble un manque reel : ces pointeurs de
0BF0A7                   	; trois octets se decomposaient jusqu'ici a la main, cote BASIC --
0BF0A7                   	;   AH=INT (AD/&10000):AM=INT ((AD-AH*&10000)/&100):AL=AD-AH*&10000-AM*&100
0BF0A7                   	;   POKE dest,AL,AM,AH
0BF0A7                   	;
0BF0A7                   	; ⛔ C'EST UNE INSTRUCTION, PAS UNE FONCTION. Le resolveur de la ROM n'est donc
0BF0A7                   	;    pas le meme : 0F58E5h teste le bit 7 et prend l'adresse TELLE QUELLE, la ou
0BF0A7                   	;    0F590Bh teste le bit 6 et ajoute 3. L'entree de repartition porte donc 080h
0BF0A7                   	;    et il n'y a PAS de prefixe de trois octets devant le point d'entree.
0BF0A7                   	;
0BF0A7                   	; ⛔ LA BOUCLE EST CELLE DE BAS_POKE (0F9F27h), Y COMPRIS SA SORTIE.
0BF0A7                   	;    On lit un caractere, on le compare a 02Ch ; si ce n'est pas une virgule, on
0BF0A7                   	;    rend la main -- mais en REMETTANT le caractere par un « dec x ». La ROM le
0BF0A7                   	;    fait par une chute : son « rc » de 0F9F2Fh tombe dans le « dec x » de
0BF0A7                   	;    0F9F30h, partage avec le chemin d'erreur. On copie cette disposition.
0BF0A7                   	;
0BF0A7                   	; ⛔ ET CHAQUE chknum PREND UN CADRE DE 15 OCTETS, QU'IL FAUT RENDRE.
0BF0A7                   	;    LPEEK n'appelle chknum qu'une fois et n'a donc jamais eu a s'en soucier.
0BF0A7                   	;    Ici la boucle en appelle un par valeur : sans le « pmdf +15 » apres chacune,
0BF0A7                   	;    les cadres s'empilent et BP finit par sortir de sa zone. Le compte doit
0BF0A7                   	;    revenir a zero sur TOUS les chemins, erreurs comprises.
0BF0A7                   	;
0BF0A7                   	; ⛔ PORTEE DES VALEURS : 20 BITS, ET C'EST dec2bin QUI L'IMPOSE.
0BF0A7                   	;    Son code (0EFB8Bh) ne convertit que 8+8+4 bits -- constate en ecrivant
0BF0A7                   	;    LPEEK. Une valeur au-dela de 0FFFFFh serait donc tronquee AVANT de nous
0BF0A7                   	;    parvenir, sans que rien ne le signale et sans que nous puissions le
0BF0A7                   	;    detecter apres coup. Sans consequence pour l'usage vise, une adresse de
0BF0A7                   	;    cette machine faisant 20 bits, mais cela doit etre dit.
0BF0A7                   	
0BF0A7                   	lpoke:
0BF0A7 05 F3 FB 0E       	        callf   chknum          ; l'adresse de destination
0BF0AB 1C 42             	        jrc     lp_ret          ; chknum a echoue : il n'a pas pris de cadre
0BF0AD 05 D4 FA 0E       	        callf   dec2bin
0BF0B1 1C 3C             	        jrc     lp_ret
0BF0B3 80 00             	        mv      a,(BP+0)        ; bit 3 = signe
0BF0B5 64 08             	        test    a,008H
0BF0B7 1A 37             	        jrnz    lp_syn
0BF0B9 80 03             	        mv      a,(BP+3)
0BF0BB 60 10             	        cmp     a,010H
0BF0BD 1E 31             	        jrnc    lp_syn          ; au-dela de 0FFFFFh
0BF0BF 85 01             	        mv      y,(BP+1)        ; Y = la destination
0BF0C1 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; rendre le cadre de la destination
0BF0C5                   	
0BF0C5                   	lp_next:
0BF0C5 90 24             	        mv      a,[x++]
0BF0C7 60 2C             	        cmp     a,02CH          ; ','
0BF0C9 1A 21             	        jrnz    lp_done         ; plus de virgule : c'est fini
0BF0CB 2D                	        pushu   y               ; la destination, que chknum n'a pas a connaitre
0BF0CC 05 F3 FB 0E       	        callf   chknum          ; la valeur
0BF0D0 1C 26             	        jrc     lp_pop
0BF0D2 05 D4 FA 0E       	        callf   dec2bin
0BF0D6 1C 20             	        jrc     lp_pop
0BF0D8 80 00             	        mv      a,(BP+0)
0BF0DA 64 08             	        test    a,008H
0BF0DC 1A 1C             	        jrnz    lp_popsyn       ; valeur negative
0BF0DE 3D                	        popu    y
0BF0DF EA 05 01          	        mvp     [y],(BP+1)      ; les TROIS octets, petit-boutien
0BF0E2 08 03             	        mv      a,003H
0BF0E4 45 50             	        add     y,a             ; adresse suivante
0BF0E6 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; rendre le cadre de la valeur
0BF0EA 13 27             	        jr      lp_next
0BF0EC                   	
0BF0EC                   	; --- sortie ----------------------------------------------------------------
0BF0EC                   	; « rc » tombe dans « dec x » : la disposition de BAS_POKE, ou le chemin de
0BF0EC                   	; succes et celui d'erreur partagent la remise en place du caractere.
0BF0EC                   	lp_done:
0BF0EC 9F                	        rc
0BF0ED                   	lp_back:
0BF0ED 7C 04             	        dec     x               ; rendre le caractere qui n'etait pas une virgule
0BF0EF                   	lp_ret:
0BF0EF 07                	        retf
0BF0F0                   	
0BF0F0                   	lp_syn:
0BF0F0 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BF0F4 08 0A             	        mv      a,err_syn
0BF0F6 97                	        sc
0BF0F7 07                	        retf
