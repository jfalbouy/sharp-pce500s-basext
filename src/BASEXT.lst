0BF505                   	; ============================================================================
0BF505                   	; INSTR ([debut,] texte, recherche)  --  position 1-based, 0 si absent
0BF505                   	; ============================================================================
0BF505                   	; Rend un NOMBRE (comme LEN/ASC) : lit les chaines, LIBERE les temporaires de U
0BF505                   	; (add u,longueur, d'apres BAS_LEN 0EECA8h), convertit par bin2dec, BP restaure
0BF505                   	; au cadre du 1er eval (comme MOD). recherche a U [..LS) ; texte a U+LS [..LT).
0BF505 00 00 00          	instr_m3: db    0,0,0
0BF508                   	instr:
0BF508                   	in_sp:
0BF508 90 24             	        mv      a,[x++]
0BF50A 60 20             	        cmp     a,020H
0BF50C 19 06             	        jrz     in_sp
0BF50E 60 28             	        cmp     a,028H
0BF510 1A ED             	        jrnz    in_syn0
0BF512 30 D8 B8 F6 0B EC 	        mv      [!sv_bp0],(bp_ram)
0BF518                   	; --- arg 1 : nombre (debut) OU chaine (texte) ---
0BF518 05 6E F2 0E       	        callf   eval
0BF51C 1C E7             	        jrc     in_ret
0BF51E 30 D8 B9 F6 0B EC 	        mv      [!sv_bp1],(bp_ram)
0BF524 65 00 80          	        test    (BP+0),080H
0BF527 1A 2E             	        jrnz    in_a1str
0BF529 05 D4 FA 0E       	        callf   dec2bin             ; debut numerique
0BF52D 1C D6             	        jrc     in_ret
0BF52F 65 00 08          	        test    (BP+0),008H
0BF532 1A EE             	        jrnz    in_range
0BF534 80 02             	        mv      a,(BP+2)
0BF536 7F 03             	        or      a,(BP+3)
0BF538 1A E8             	        jrnz    in_range
0BF53A 80 01             	        mv      a,(BP+1)
0BF53C 60 00             	        cmp     a,000H
0BF53E 18 E2             	        jrz     in_range            ; debut 0 interdit (1-based)
0BF540 A8 BD F6 0B       	        mv      [!in_start],a
0BF544 90 24             	        mv      a,[x++]
0BF546 60 2C             	        cmp     a,02CH
0BF548 1A CE             	        jrnz    in_syn
0BF54A 05 6E F2 0E       	        callf   eval                ; texte
0BF54E 1C B6             	        jrc     in_bad
0BF550 65 00 80          	        test    (BP+0),080H
0BF553 18 B9             	        jrz     in_type
0BF555 12 06             	        jr      in_havetext
0BF557                   	in_a1str:
0BF557 08 01             	        mv      a,001H
0BF559 A8 BD F6 0B       	        mv      [!in_start],a
0BF55D                   	in_havetext:
0BF55D 80 04             	        mv      a,(BP+4)
0BF55F A8 BE F6 0B       	        mv      [!in_lt],a          ; longueur du texte
0BF563 90 24             	        mv      a,[x++]
0BF565 60 2C             	        cmp     a,02CH
0BF567 1A AF             	        jrnz    in_syn
0BF569 05 6E F2 0E       	        callf   eval                ; recherche
0BF56D 1C 97             	        jrc     in_bad
0BF56F 65 00 80          	        test    (BP+0),080H
0BF572 18 9A             	        jrz     in_type
0BF574 90 24             	        mv      a,[x++]
0BF576 60 29             	        cmp     a,029H
0BF578 1A 9E             	        jrnz    in_syn
0BF57A                   	; --- recherche : mise en place ---
0BF57A                   	; (BP+5) = maxp ; (BP+6) = octet temporaire de comparaison ; p en variable module
0BF57A                   	; (on n'utilise QUE (BP+5)/(BP+6), prouves surs ; le cadre d'eval peut ne pas
0BF57A                   	;  atteindre (BP+7)).
0BF57A 88 BE F6 0B       	        mv      a,[!in_lt]
0BF57E 4A 04             	        sub     a,(BP+4)            ; LT - LS
0BF580 1C 52             	        jrc     in_notfound         ; LS > LT
0BF582 A0 05             	        mv      (BP+5),a            ; maxp (0-based)
0BF584 88 BD F6 0B       	        mv      a,[!in_start]
0BF588 7C 00             	        dec     a
0BF58A A8 C0 F6 0B       	        mv      [!in_p],a           ; p = debut - 1
0BF58E                   	in_outer:
0BF58E 88 C0 F6 0B       	        mv      a,[!in_p]
0BF592 63 05             	        cmp     (BP+5),a            ; maxp - p : carry si p>maxp
0BF594 1C 3E             	        jrc     in_notfound
0BF596                   	in_cmp:
0BF596 B4 37             	        pushs   x
0BF598 FD 46             	        mv      x,u
0BF59A 80 04             	        mv      a,(BP+4)
0BF59C 45 40             	        add     x,a
0BF59E 88 C0 F6 0B       	        mv      a,[!in_p]
0BF5A2 45 40             	        add     x,a                 ; X = texte + p
0BF5A4 FD 56             	        mv      y,u                 ; Y = recherche
0BF5A6 81 04             	        mv      il,(BP+4)
0BF5A8 FD 01             	        mv      a,il
0BF5AA 60 00             	        cmp     a,000H
0BF5AC 18 0E             	        jrz     in_hit              ; recherche vide
0BF5AE                   	in_ck:
0BF5AE 90 24             	        mv      a,[x++]
0BF5B0 A0 06             	        mv      (BP+6),a            ; caractere du texte
0BF5B2 90 25             	        mv      a,[y++]
0BF5B4 63 06             	        cmp     (BP+6),a            ; (textchar) - (searchchar) : Z si egaux
0BF5B6 1A 0E             	        jrnz    in_miss
0BF5B8 7C 01             	        dec     il
0BF5BA 1B 0E             	        jrnz    in_ck
0BF5BC                   	in_hit:
0BF5BC 94 27             	        pops    x
0BF5BE 88 C0 F6 0B       	        mv      a,[!in_p]
0BF5C2 6C 00             	        inc     a
0BF5C4 12 10             	        jr      in_found
0BF5C6                   	in_miss:
0BF5C6 94 27             	        pops    x
0BF5C8 88 C0 F6 0B       	        mv      a,[!in_p]
0BF5CC 6C 00             	        inc     a
0BF5CE A8 C0 F6 0B       	        mv      [!in_p],a
0BF5D2 13 46             	        jr      in_outer
0BF5D4                   	in_notfound:
0BF5D4 08 00             	        mv      a,000H
0BF5D6                   	in_found:
0BF5D6 A8 BF F6 0B       	        mv      [!in_res],a
0BF5DA                   	; --- liberer les deux chaines de U, puis rendre le nombre ---
0BF5DA 80 04             	        mv      a,(BP+4)
0BF5DC 45 60             	        add     u,a
0BF5DE 88 BE F6 0B       	        mv      a,[!in_lt]
0BF5E2 45 60             	        add     u,a
0BF5E4 30 D0 EC B9 F6 0B 	        mv      (bp_ram),[!sv_bp1]
0BF5EA CC 00 00          	        mv      (BP+0),000H
0BF5ED 88 BF F6 0B       	        mv      a,[!in_res]
0BF5F1 A0 01             	        mv      (BP+1),a
0BF5F3 CD 02 00 00       	        mvw     (BP+2),00000H
0BF5F7 2C                	        pushu   x               ; ⛔ bin2dec ECRASE X (le point de reprise) : le sauver
0BF5F8 05 6F FB 0E       	        callf   bin2dec
0BF5FC 3C                	        popu    x
0BF5FD 9F                	        rc
0BF5FE 07                	        retf
