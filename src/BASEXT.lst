0BF124 05 D4 FA 0E       	        callf   dec2bin         ; A -> entier 20 bits en (bp+1)..(bp+3)
0BF128 1C 7A             	        jrc     md_ret
0BF12A 65 00 08          	        test    (BP+0),008H     ; bit 3 : le signe
0BF12D 1A 98             	        jrnz    md_neg
0BF12F                   	
0BF12F                   	; ⛔ A EST MIS A L'ABRI ICI, ET C'EST TOUT L'INTERET DE CETTE VERSION. Le second
0BF12F                   	;    chknum ecrit sa valeur en (bp+0), et rien ne garantit qu'il ait d'abord
0BF12F                   	;    decale le cadre : la version precedente l'a suppose et perdait A.
0BF12F DA B5 F6 0B 01    	        mvp     [!sv_a],(BP+1)
0BF134                   	
0BF134 90 24             	        mv      a,[x++]
0BF136 60 2C             	        cmp     a,02CH          ; ',' obligatoire : il faut DEUX arguments
0BF138 1A 79             	        jrnz    md_syn
0BF13A                   	
0BF13A                   	; --- B, le diviseur ---------------------------------------------------------
0BF13A 05 6E F2 0E       	        callf   eval            ; expression complete -> (bp+0)
0BF13E 1C 6B             	        jrc     md_bad
0BF140 65 00 80          	        test    (BP+0),080H     ; bit 7 : c'est une chaine
0BF143 1A 78             	        jrnz    md_type
0BF145 05 D4 FA 0E       	        callf   dec2bin         ; B -> entier 20 bits en (bp+1)..(bp+3)
0BF149 1C 60             	        jrc     md_bad
0BF14B 65 00 08          	        test    (BP+0),008H
0BF14E 1A 77             	        jrnz    md_neg
0BF150                   	
0BF150 90 24             	        mv      a,[x++]
0BF152 60 29             	        cmp     a,029H          ; ')' obligatoire
0BF154 1A 5D             	        jrnz    md_syn
0BF156                   	
0BF156                   	; --- B = 0 : erreur 21, celle que la ROM emploie pour le meme cas (0ECD67h) --
0BF156 80 01             	        mv      a,(BP+1)
0BF158 7F 02             	        or      a,(BP+2)
0BF15A 7F 03             	        or      a,(BP+3)
0BF15C 18 73             	        jrz     md_zero
0BF15E                   	
0BF15E 2C                	        pushu   x               ; le point de reprise de l'interpreteur
0BF15F                   	
0BF15F                   	; ============================================================================
0BF15F                   	; LA DIVISION BINAIRE A RESTAURATION -- 24 tours, tout en RAM interne
0BF15F                   	; ============================================================================
0BF15F                   	; Tout tient dans la QUEUE du cadre courant, (bp+4) a (bp+14), dont dec2bin n'a
0BF15F                   	; plus l'usage. C'est de la RAM interne, donc rapide, et cela reste valable quel
0BF15F                   	; que soit le cadre ou nous sommes.
0BF15F                   	;
0BF15F                   	;   A    : (bp+4),(bp+5),(bp+6)     relu de sv_a ; consomme par le decalage --
0BF15F                   	;                                   le quotient est jete, MOD n'en veut pas
0BF15F                   	;   cnt  : (bp+7)                   le compteur de tours
0BF15F                   	;   rst  : (bp+8),(bp+9),(bp+10)    le reste en construction
0BF15F                   	;   tmp  : (bp+12),(bp+13),(bp+14)  rst - B, garde s'il n'y a pas d'emprunt
0BF15F                   	;   B    : (bp+1),(bp+2),(bp+3)     la ou dec2bin vient de le mettre
0BF15F                   	;
0BF15F                   	; ⛔ SHL, ET SURTOUT PAS ROL -- C'EST LA QUE MOD RENDAIT 0 POUR TOUT.
0BF15F                   	;    Sur ce processeur, ROL/ROR sont CIRCULAIRES dans l'octet : la retenue recoit
0BF15F                   	;    bien le bit sortant, mais ce bit revient aussi en bas du MEME octet, et rien
0BF15F                   	;    ne passe a l'octet suivant. Une premiere version decalait A avec six « rol » :
0BF15F                   	;    chaque octet tournait sur lui-meme, le reste ne recevait jamais aucun bit et
0BF15F                   	;    valait donc 0 -- pour toutes les valeurs, ce qu'a montre la machine.
0BF15F                   	;
0BF15F                   	;    LA ROM TRANCHE, ET DANS LES DEUX SENS :
0BF15F                   	;      . elle CHAINE « shr » sur des octets consecutifs -- « F5 12 F5 13 F5 14
0BF15F                   	;        F5 15 F5 16 » en 0EEBB8h, un decalage de cinq octets. Seul un decalage
0BF15F                   	;        A TRAVERS la retenue peut se chainer ainsi ;
0BF15F                   	;      . et elle emploie « ror » la ou il faut LIRE les bits sans detruire
0BF15F                   	;        l'octet : bin2dec fait « ror (00Bh) / jrnc » huit fois par octet
0BF15F                   	;        (0EFBA3h), et huit rotations circulaires le rendent intact.
0BF15F                   	;    Les deux usages sont coherents, et ils s'excluent.
0BF15F                   	;
0BF15F                   	; 📄 Notre propre reference (SC62015_InstructionSet_Reference.md) decrit ROL et
0BF15F                   	;    SHL de la MEME facon, « via C » -- ce qui ne peut pas etre vrai des deux.
0BF15F                   	;    A corriger la-bas : la ROM est l'arbitre.
0BF15F                   	;
0BF15F                   	; ⛔ ET CES DECALAGES NE CONSULTENT PAS I. bin2dec enchaine « ror (00Bh) / jrnc »
0BF15F                   	;    alors que IL vaut encore 4 d'un dadl precedent, et n'en rotationne qu'un
0BF15F                   	;    octet. Les instructions BLOC, elles, bouclent I fois -- « mv il,00Fh /
0BF15F                   	;    mvl (000h),(00Fh) » de la ROM recopie bien 15 octets.
0BF15F                   	md_calc:
0BF15F D2 04 B5 F6 0B    	        mvp     (BP+4),[!sv_a]  ; A, revenu de l'abri
0BF164 DC 08 00 00 00    	        mvp     (BP+8),000000H  ; reste = 0
0BF169 CC 07 18          	        mv      (BP+7),00024    ; 24 tours : la largeur de A
0BF16C                   	md_loop:
0BF16C 9F                	        rc
0BF16D F7 04             	        shl     (BP+4)          ; A <<= 1 ; le bit sortant part dans la retenue
0BF16F F7 05             	        shl     (BP+5)
0BF171 F7 06             	        shl     (BP+6)
0BF173 F7 08             	        shl     (BP+8)          ; reste = reste<<1 | ce bit
0BF175 F7 09             	        shl     (BP+9)
0BF177 F7 0A             	        shl     (BP+10)
0BF179                   	
0BF179 CA 0C 08          	        mvp     (BP+12),(BP+8)  ; tmp = reste
0BF17C 9F                	        rc                      ; SBCL retranche AUSSI la retenue : la vider
0BF17D 09 03             	        mv      il,003
0BF17F 5C 0C 01          	        sbcl    (BP+12),(BP+1)  ; tmp = reste - B, sur trois octets
0BF182 1C 03             	        jrc     md_next         ; emprunt : reste < B, on ne retranche pas
0BF184 CA 08 0C          	        mvp     (BP+8),(BP+12)  ; sinon le reste devient tmp
0BF187                   	md_next:
0BF187 7D 07             	        dec     (BP+7)
0BF189 1B 1F             	        jrnz    md_loop
