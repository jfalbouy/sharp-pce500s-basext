0BF6DB                   	
0BF6DB                   	; xc_num -- une expression numerique entiere de 0 a 255.
0BF6DB                   	;           CY=0 : A = la valeur, BP rendu a sv_bp0.
0BF6DB                   	;           CY=1 : A = code d'erreur, BP rendu a sv_bp0.  APPEL PROCHE.
0BF6DB                   	xc_num:
