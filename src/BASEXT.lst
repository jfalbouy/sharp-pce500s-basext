0BF6F1 80 02             	        mv      a,(BP+2)
0BF6F3 7F 03             	        or      a,(BP+3)
0BF6F5 1A 0E             	        jrnz    xn_range                ; au-dela de 255
0BF6F7 80 01             	        mv      a,(BP+1)
0BF6F9 30 D0 EC 8B F9 0B 	        mv      (bp_ram),[!sv_bp0]      ; rendre le cadre d'eval
0BF6FF 9F                	        rc
0BF700 06                	        ret
