000000                   	; ============================================================================
000000                   	; BASEXT.ASM -- le module d'extensions du BASIC
000000                   	; ============================================================================
000000                   	; ATTENTION : LES NOMS DE FICHIER SHARP SONT EN 8.3
000000                   	;    Ce module s'est d'abord appele BASIC_EXT -- neuf caracteres, un de trop.
000000                   	;    La regle vaut pour tout ce qui part sur le lecteur, .OBJ comme .UU :
000000                   	;    LOAD M "S1:BASEXT.OBJ" ne pardonne pas un nom trop long.
000000                   	; ============================================================================
000000                   	;                 LPEEK (fonction, 3 octets), WPEEK (fonction, 2 octets)
000000                   	;                 et LPOKE (INSTRUCTION, ecrit des valeurs de 3 octets)
000000                   	; ============================================================================
000000                   	;
000000                   	; ⛔ LE NOM NE POUVAIT PAS ETRE "PEEKX", ET L'ESSAI MACHINE L'A MONTRE.
000000                   	;    Le tokeniseur consulte la table de la ROM AVANT la notre. "PEEKX" y est
000000                   	;    donc coupe en PEEK + la variable X, et la ligne devient une erreur de
000000                   	;    syntaxe -- relue ensuite, elle s'affiche litteralement
000000                   	;    "PRINT HEX$ PEEK X &BF100".
000000                   	;
000000                   	;    LA REGLE, valable pour toute extension : un mot-cle ajoute ne doit pas
000000                   	;    COMMENCER par un mot-cle existant, ni etre le debut de l'un d'eux. Cela se
000000                   	;    verifie avant d'ecrire une ligne de code, sur les 168 noms de
000000                   	;    Data/BasicTokens.csv. LPEEK est libre dans les deux sens.
000000                   	;
000000                   	;   LPEEK &BF0B8   rend la valeur de l'adresse 3 octets rangee en &BF0B8,
000000                   	;                  soit l'equivalent de
000000                   	;                  PEEK &BF0B8 + PEEK &BF0B9 * 256 + PEEK &BF0BA * 65536
000000                   	;
000000                   	; Ce n'est pas un CALL : c'est une INSTRUCTION DU LANGAGE, utilisable dans une
000000                   	; expression -- PRINT LPEEK &BF0B8, A = LPEEK X + 1, etc.
000000                   	;
000000                   	;   LOAD M "S1:LPEEK.OBJ" : CALL &BF000      installe
000000                   	;   PRINT HEX$ LPEEK &BF0B8
000000                   	;
000000                   	; ---------------------------------------------------------------------------
000000                   	; COMMENT L'INTERPRETEUR NOUS TROUVE  (tout est lu dans la ROM)
000000                   	; ---------------------------------------------------------------------------
000000                   	;
000000                   	; Deux crochets dans la zone de travail du BASIC, x = (baswrk) = (0D1h) :
000000                   	;
000000                   	;   [x+090h]   la table de mots-cles      (texte -> token)
000000                   	;   [x+093h]   la table de repartition    (token -> routine)
000000                   	;
000000                   	; La ROM y met 0FFFFFh au demarrage (SUB_F93C3) : la sentinelle "rien".
000000                   	;
000000                   	; La repartition se balaie par SUB_F593D (0F593Dh) : entrees de QUATRE octets,
000000                   	; token puis adresse, arret sur un token 000h.
000000                   	;
000000                   	; ⛔ ET LE QUARTET HAUT DU 3e OCTET D'ADRESSE EST UN DRAPEAU. Les deux
000000                   	;    resolveurs de la ROM sont cote a cote et ne different que par le bit :
000000                   	;
000000                   	;      0F58E5h  instruction : test a,080h -> routine = l'adresse telle quelle
000000                   	;      0F590Bh  FONCTION    : test a,040h -> routine = l'adresse + 3
000000                   	;
000000                   	;    PEEKX etant une fonction, on range donc (routine - 3) avec le bit 6 arme.
000000                   	;    Les trois octets sautes n'ont aucun sens : dans la ROM, ce sont ceux de la
000000                   	;    routine precedente. On y met trois zeros.
000000                   	;
000000                   	; ---------------------------------------------------------------------------
000000                   	; LE CORPS -- calque sur BAS_PEEK (0F9F44h), avec les entrees LOINTAINES
000000                   	; ---------------------------------------------------------------------------
000000                   	;
000000                   	; Une extension vit en page 0B, les services en 0E et 0F. Un service termine
000000                   	; par RET ne se laisse PAS appeler d'ici : son retour depile 2 octets et reste
000000                   	; dans SA page. Il faut donc, pour chaque service, l'entree qui finit par RETF.
000000                   	;
000000                   	;   BAS_PEEK fait            ici on fait              parce que
000000                   	;   -----------------------  -----------------------  ------------------------
000000                   	;   call SUB_F5F9C           callf 0EFBF3h            F5F9C finit par RET ;
000000                   	;                            puis callf 0EFAD4h       EFBF3 et EFAD4 par RETF.
000000                   	;                                                     F5F9C n'etait que
000000                   	;                                                     "callf EFBF3 + call
000000                   	;                                                     F5C9A", et F5C9A n'etait
000000                   	;                                                     que "callf EFAD4 + mv y".
000000                   	;   callf SUB_EFB6F          callf 0EFB6Fh            deja lointaine
000000                   	;
000000                   	; 0EFAD4h et 0EFB6Fh sont les commandes 07Eh et 07Fh du device 9 -- dec2bin et
000000                   	; bin2dec. Le travail sur la bibliotheque mathematique sert directement ici.
000000                   	;
000000                   	; ⛔ LE CADRE BP -- ET J'AI D'ABORD MAL LU SUB_F5C9A.
000000                   	;
000000                   	;    Elle se termine par "jr LOC_F5C6F", que je n'avais pas suivi. Or LOC_F5C6F
000000                   	;    fait "pmdf (bp_ram),00Fh" : BP + 15. Le compte, entree a sortie :
000000                   	;
000000                   	;      entree                          BP = B
000000                   	;      callf chknum                    BP = B-15   <- le cadre de la valeur
000000                   	;      SUB_F5C9A finit par +15         BP = B
000000                   	;      BAS_PEEK fait -15               BP = B-15   <- ou il ecrit son resultat
000000                   	;
000000                   	;    Ici on n'appelle pas F5C9A, donc on n'a PAS le +15 : apres chknum, BP vaut
000000                   	;    deja B-15, c'est-a-dire exactement le bon cadre. Il ne faut donc AUCUN
000000                   	;    pmdf sur le chemin de succes. La premiere version gardait le -15 de
000000                   	;    BAS_PEEK sans son +15 : elle ecrivait en B-30.
000000                   	;
000000                   	;    Sur le chemin d'ERREUR, en revanche, il faut le +15 : F5C9A le fait dans
000000                   	;    tous les cas, y compris son erreur 33 (LOC_F5C74 saute a LOC_F5C6F).
000000                   	;
000000                   	; ⛔ ET ON ECRIT (BP+n), PAS (000H). Sous pre_on, "(000H)" designe l'adresse
000000                   	;    DIRECTE 0 ; le mode (BP+n) est celui qui n'emet PAS d'octet PRE. Le
000000                   	;    controle se fait dans l'OBJET : sur ces lignes, BAS_PEEK ne porte aucun
000000                   	;    PRE (E0 05 01, CC 00 00, CD 02 00 00). Une premiere version de ce fichier
000000                   	;    portait "30 80 00" -- un PRE, donc l'adresse directe : la fonction lisait
000000                   	;    la RAM interne 0 au lieu du cadre de l'argument.
000000                   	;
000000                   	;       xasm2026-4 BASEXT.ASM -O -L -S -B -K
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	basptr: equ 0D1H ; POINTEUR (3 octets) vers la zone de travail de l'interpreteur BASIC, en RAM interne. C'est la COPIE de celui que la ROM lit en 0BFD0Eh (baswrk) : elle la fait par mvp (0D1h),[0BFD0Eh] en 0F98CAh. Les crochets d'extension du BAS ...
000000                   	bp_ram: equ 0ECH ; base pointer RAM interne
000000                   	
000000                   	; --- les entrees LOINTAINES de la ROM (toutes terminees par RETF) -----------
000000                   	chknum:   equ   0EFBF3H    ; evalue l'expression numerique, verifie le type
000000                   	dec2bin:  equ   0EFAD4H    ; le nombre -> entier 24 bits en (bp+1)..(bp+3)
000000                   	bin2dec:  equ   0EFB6FH    ; l'entier de (bp+0)..(bp+3) -> nombre BASIC
000000                   	
000000                   	; ⛔ DEUX EVALUATEURS, ET ILS NE LISENT PAS LA MEME CHOSE.
000000                   	;    chknum (0EFBF3h) ne lit qu'UN TERME : un nombre, une variable, un appel de
000000                   	;    fonction, ou une expression entre parentheses -- mais il s'arrete au premier
000000                   	;    OPERATEUR. C'est ce que PEEK emploie (0F5F9Ch), et c'est pourquoi
000000                   	;    « PEEK &BFD1C*&100 » se lit « (PEEK &BFD1C)*&100 ».
000000                   	;    eval (0EF26Eh) evalue une EXPRESSION COMPLETE, operateurs compris. C'est ce
000000                   	;    qu'emploie POINT (x,y), via SUB_F5F65 en 0F5F65h -- et la reconnaissance des
000000                   	;    operateurs AND/OR/XOR est cablee juste a cote, en 0EF2C5h. Douze sites de la
000000                   	;    ROM l'appellent par « callf ».
000000                   	;
000000                   	;    MOD emprunte sa syntaxe a POINT : il lui faut donc le second, et LPEEK garde
000000                   	;    le premier puisqu'il est calque sur PEEK. Mesure sur machine avant la
000000                   	;    correction : MOD (17,5) et MOD (A,B) passaient, mais MOD (A+1,B) et
000000                   	;    MOD (I*3571,997) rendaient une erreur -- chknum lisait « A », puis butait
000000                   	;    sur le « + ».
000000                   	;
000000                   	;    ⚠️ eval ne signale PAS lui-meme le type : ses appelants de la ROM font le
000000                   	;    « test (000h),080h » a sa suite (0F5F6Bh). On fait de meme.
000000                   	eval:     equ   0EF26EH    ; expression numerique complete -> (bp+0)
000000                   	
000000                   	
000000                   	tk_lp:    equ   007H       ; LPEEK -- libre dans la table de la ROM
000000                   	tk_wp:    equ   00AH       ; WPEEK -- libre aussi (BASCOM occupe 04-06)
000000                   	tk_lpo:   equ   00EH       ; LPOKE -- libre
000000                   	tk_mod:   equ   00FH       ; MOD   -- libre
000000                   	tk_uc:    equ   0C6H       ; UCASE$ (fonctions chaine ajoutees)
000000                   	tk_lc:    equ   0C7H       ; LCASE$
000000                   	tk_tr:    equ   0C3H       ; TRIM$
000000                   	tk_lt:    equ   0C4H       ; LTRIM$
000000                   	tk_rt:    equ   0C5H       ; RTRIM$
000000                   	tk_rp:    equ   0C8H       ; REPT$
000000                   	tk_sr:    equ   0C9H       ; SREPT$
000000                   	tk_in:    equ   0C2H       ; INSTR (rend un NOMBRE)
000000                   	alloc:    equ   0EF0DDH    ; reserve BA octets sur U (U -= BA) ; carry = erreur 54
000000                   	
000000                   	
000000                   	; ⛔ NE PAS ECRIRE « baswrk » ICI. C'est la ZONE de travail, en memoire EXTERNE
000000                   	;    (0BFD0Eh) -- nom repris du listing de E. Kako, ou il est declare
000000                   	;    « baswrk: equ 0bfd0eh ». Le pointeur qu'il nous faut est en RAM INTERNE, a
000000                   	;    0D1h, que le carnet nommait « baswrk » lui aussi jusqu'au 2026-09-03 et
000000                   	;    nomme desormais « basptr ». Depuis, pce500.inc EXPOSE les deux et le
000000                   	;    generateur REFUSE une collision de noms : il n'y a plus d'equ local ici.
000000                   	;    Et « mv x,(baswrk) » ne proteste pas : l'operande interne fait 8 bits, XASM
000000                   	;    TRONQUE 0BFD0Eh en 0Eh. Le code ecrivait donc les crochets en
000000                   	;    [(00Eh)+090h], et la table d'extension n'a jamais ete installee.
000000                   	;    Verifiable dans l'objet : on doit lire « 30 84 D1 », pas « 30 84 0E ».
000000                   	err_syn:  equ   00AH       ; erreur BASIC 10, Syntax error
000000                   	err_range: equ  021H       ; erreur BASIC 33, Data out of range
000000                   	err_type: equ   05AH       ; erreur BASIC 90, Type mismatch -- le code que
000000                   	                          ; chknum emploie lui-meme (0EFC04h)
000000                   	err_buf:  equ   036H       ; erreur BASIC 54, Buffer space exceeded
000000                   	err_div:  equ   015H       ; erreur BASIC 21, Division by zero -- le code
000000                   	                          ; que la ROM elle-meme emploie, lu en 0ECD67h
000000                   	
0BF000                   	        org     0BF000H
0BF000                   	        pre_on
0BF000                   	
0BF000                   	; ============================================================================
0BF000                   	; L'INSTALLATION -- c'est ici que mene CALL &BF000
0BF000                   	; ============================================================================
0BF000                   	start:
0BF000 2C                	        pushu   x               ; X porte le point de reprise de l'interpreteur
0BF001 2B                	        pushu   i
0BF002 30 84 D1          	        mv      x,(basptr)
0BF005                   	
0BF005                   	; ⛔ NE SAUVER LES CROCHETS QUE S'ILS SONT ENCORE CEUX DE LA ROM.
0BF005                   	;    Une premiere version sauvait sans regarder : au SECOND CALL &BF000 elle
0BF005                   	;    ecrasait old_kw et old_disp avec NOS PROPRES tables, et les valeurs
0BF005                   	;    d'origine etaient perdues -- la desinstallation avec. Constate sur machine
0BF005                   	;    le 2026-09-05 : le vidage montrait old_kw = 0BF1B1h et old_disp = 0BF1CCh,
0BF005                   	;    c'est-a-dire kw_table et disp_table de ce module.
0BF005                   	;
0BF005                   	;    ⛔ ET LA RAISON N'EST PAS CELLE QUE J'AVAIS ECRITE. J'avais justifie le
0BF005                   	;    test par « les tables du BASIC vivent en page 0F ». C'est faux : le crochet
0BF005                   	;    ne pointe JAMAIS sur la table de la ROM. La ROM y ecrit une SENTINELLE,
0BF005                   	;    0FFFFFh, et cela se lit en 0F93C3h :
0BF005                   	;
0BF005                   	;       mv  x,(basptr)
0BF005                   	;       mv  y,0FFFFFh
0BF005                   	;       mv  [x+090h],y
0BF005                   	;       mv  [x+093h],y
0BF005                   	;
0BF005                   	;    L'octet de poids fort d'un crochet vierge vaut donc 0Fh, et le test le
0BF005                   	;    reconnait -- mais ce qu'il reconnait est la sentinelle, pas une table. Une
0BF005                   	;    extension, elle, vit en RAM, page 0B : son crochet ne peut pas valoir 0Fh.
0BF005                   	;    Le test est donc juste, et il l'est desormais pour la bonne raison.
0BF005                   	;
0BF005                   	;    ⚠️ Il pourrait etre plus strict : comparer les TROIS octets a 0FFFFFh plutot
0BF005                   	;    que le seul poids fort. En l'etat il accepterait n'importe quel 0Fxxxxh, ce
0BF005                   	;    qu'aucune extension ne peut produire -- mais la ROM le pourrait un jour.
0BF005                   	;
0BF005                   	;    ⚠️ Et il n'y a PAS de chainage : un second module ecraserait le premier.
0BF005                   	;    Refuser d'ecraser la sauvegarde est donc la seule conduite sensee.
0BF005 90 84 92          	        mv      a,[x+092H]      ; poids fort du crochet des mots-cles
0BF008 60 0F             	        cmp     a,00FH          ; encore la table de la ROM ?
0BF00A 1A 0E             	        jrnz    deja_ext        ; non : ne rien ecraser
0BF00C 95 84 90          	        mv      y,[x+090H]      ; l'ancienne table de mots-cles
0BF00F AD C6 F6 0B       	        mv      [old_kw],y      ;   sauvee : de quoi desinstaller
0BF013 95 84 93          	        mv      y,[x+093H]      ; l'ancienne table de repartition
0BF016 AD C9 F6 0B       	        mv      [old_disp],y
0BF01A                   	deja_ext:
0BF01A 0D 2C F6 0B       	        mv      y,kw_table
0BF01E B5 84 90          	        mv      [x+090H],y
0BF021 0D 84 F6 0B       	        mv      y,disp_table
0BF025 B5 84 93          	        mv      [x+093H],y
0BF028 3B                	        popu    i
0BF029 3C                	        popu    x
0BF02A 9F                	        rc                      ; carry CLAIR : retour propre a BASIC
0BF02B 07                	        retf
0BF02C                   	
0BF02C                   	; ============================================================================
0BF02C                   	; LA FONCTION -- l'interpreteur y saute a lpeek_m3 + 3
0BF02C                   	; ============================================================================
0BF02C                   	lpeek_m3:
0BF02C 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BF02F                   	
0BF02F                   	lpeek:
0BF02F 05 F3 FB 0E       	        callf   chknum          ; l'argument -> cadre pousse, nombre en (bp+0)
0BF033 1C 27             	        jrc     dehors          ; X n'est pas encore sauve : rien a rendre
0BF035 05 D4 FA 0E       	        callf   dec2bin         ; -> entier 24 bits en (bp+1)..(bp+3)
0BF039 1C 21             	        jrc     dehors
0BF03B 80 00             	        mv      a,(BP+0)        ; (bp+0) : bit 3 = signe
0BF03D 64 08             	        test    a,008H
0BF03F 1A 1C             	        jrnz    refus           ; adresse negative
0BF041 80 03             	        mv      a,(BP+3)        ; l'octet de poids fort du 24 bits
0BF043 60 10             	        cmp     a,010H
0BF045 1E 16             	        jrnc    refus           ; au-dela de 0FFFFFh : hors de l'espace
0BF047                   	
0BF047                   	; ⛔ X PORTE LE POINT DE REPRISE, ET bin2dec L'ECRASE.
0BF047                   	;    chknum a fait AVANCER X au-dela de l'argument : c'est cette valeur-la que
0BF047                   	;    l'interpreteur attend au retour. On la sauve donc APRES chknum, jamais
0BF047                   	;    avant -- exactement ou BAS_PEEK place son pushu (0F9F49h).
0BF047                   	;    L'oubli ne plante pas : le nom est reconnu, la fonction s'execute, et
0BF047                   	;    l'interpreteur reprend n'importe ou -- "Syntax error" sans autre indice.
0BF047 2C                	        pushu   x
0BF048                   	
0BF048 85 01             	        mv      y,(BP+1)        ; l'adresse demandee
0BF04A E2 05 01          	        mvp     (BP+1),[y]      ; les TROIS octets a cette adresse
0BF04D                   	
0BF04D                   	; ⛔ bin2dec NE CONVERTIT QUE 20 BITS, et c'est lu dans son code (0EFB8Bh) :
0BF04D                   	;    trois passes de decalage, 8 bits sur (bp+11), 8 sur (bp+12), puis
0BF04D                   	;    QUATRE seulement sur (bp+13) -- « mv (00Eh),004h ». 8+8+4 = 20. Le quartet
0BF04D                   	;    haut du troisieme octet est ignore par construction : c'est un convertisseur
0BF04D                   	;    d'ADRESSE, et une adresse fait 20 bits sur cette machine.
0BF04D                   	;    Mesure : &345678 revenait en &045678, sans que rien ne le signale.
0BF04D                   	;    On REFUSE donc plutot que de mentir -- une valeur fausse en silence est
0BF04D                   	;    pire qu'une erreur.
0BF04D 80 03             	        mv      a,(BP+3)
0BF04F 70 F0             	        and     a,0F0H
0BF051 1A 12             	        jrnz    hors_plage      ; quartet haut non nul : bin2dec le perdrait
0BF053                   	
0BF053 CC 00 00          	        mv      (BP+0),000H     ; positif, simple precision
0BF056 05 6F FB 0E       	        callf   bin2dec         ; -> nombre BASIC en (bp+0)
0BF05A 9F                	        rc
0BF05B 3C                	        popu    x               ; rendre son point de reprise a l'interpreteur
0BF05C                   	dehors:
0BF05C 07                	        retf
0BF05D                   	
0BF05D                   	refus:
0BF05D 30 47 EC 0F       	        pmdf    (bp_ram),00FH   ; +15 : rendre BP comme le fait SUB_F5C9A
0BF061 08 0A             	        mv      a,err_syn
0BF063 97                	        sc
0BF064 07                	        retf
0BF065                   	
0BF065                   	; La valeur lue depasse 20 bits : erreur 33, celle que SUB_F5C9A emploie pour
0BF065                   	; le meme cas. X a ete sauve, il faut le rendre.
0BF065                   	hors_plage:
0BF065 3C                	        popu    x
0BF066 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BF06A 08 21             	        mv      a,err_range
0BF06C 97                	        sc
0BF06D 07                	        retf
0BF06E                   	
0BF06E                   	; ============================================================================
0BF06E                   	; LA SECONDE FONCTION -- WPEEK, deux octets au lieu de trois
0BF06E                   	; ============================================================================
0BF06E                   	; Meme structure exactement. Elle n'existe que pour eprouver l'ENCHAINEMENT :
0BF06E                   	; nos deux tables n'avaient jamais porte qu'une seule entree, donc ni le
0BF06E                   	; balayage de SUB_F593D (« add y,004h » en boucle) ni celui du tokeniseur
0BF06E                   	; n'etaient exerces. Deux entrees suffisent a les mettre en defaut s'ils le
0BF06E                   	; sont -- et a montrer qu'aucune adresse n'en ecrase une autre.
0BF06E                   	;
0BF06E                   	; WPEEK n'a pas besoin du garde-fou des 20 bits : deux octets tiennent
0BF06E                   	; toujours dedans.
0BF06E                   	
0BF06E                   	wpeek_m3:
0BF06E 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BF071                   	
0BF071                   	wpeek:
0BF071 05 F3 FB 0E       	        callf   chknum
0BF075 1C 24             	        jrc     dehors2
0BF077 05 D4 FA 0E       	        callf   dec2bin
0BF07B 1C 1E             	        jrc     dehors2
0BF07D 80 00             	        mv      a,(BP+0)
0BF07F 64 08             	        test    a,008H
0BF081 1A 19             	        jrnz    refus2
0BF083 80 03             	        mv      a,(BP+3)
0BF085 60 10             	        cmp     a,010H
0BF087 1E 13             	        jrnc    refus2
0BF089 2C                	        pushu   x
0BF08A 85 01             	        mv      y,(BP+1)
0BF08C                   	; ⛔ mvw, PAS mv. Les trois largeurs sont mv (1 octet), mvw (2) et mvp (3) --
0BF08C                   	;    « mv » ne transfere QU'UN octet, et un commentaire disant « deux octets :
0BF08C                   	;    mv, pas mvp » ne le rend pas vrai. Mesure : WPEEK rendait F178 et F1B8,
0BF08C                   	;    l'octet bas juste et l'octet haut jamais ecrit, donc laisse a sa valeur
0BF08C                   	;    precedente -- F1 les deux fois.
0BF08C E1 05 01          	        mvw     (BP+1),[y]      ; DEUX octets
0BF08F CC 03 00          	        mv      (BP+3),000H     ; le troisieme reste nul
0BF092 CC 00 00          	        mv      (BP+0),000H
0BF095 05 6F FB 0E       	        callf   bin2dec
0BF099 9F                	        rc
0BF09A 3C                	        popu    x
0BF09B                   	dehors2:
0BF09B 07                	        retf
0BF09C                   	
0BF09C                   	refus2:
0BF09C 30 47 EC 0F       	        pmdf    (bp_ram),00FH
0BF0A0 08 0A             	        mv      a,err_syn
0BF0A2 97                	        sc
0BF0A3 07                	        retf
0BF0A4                   	
0BF0A4                   	; ============================================================================
0BF0A4                   	; L'INSTRUCTION LPOKE destination,valeur1,valeur2,...
0BF0A4                   	; ============================================================================
0BF0A4                   	; Ecrit chaque valeur sur TROIS octets, en ordre petit-boutien, a des adresses
0BF0A4                   	; consecutives :
0BF0A4                   	;
0BF0A4                   	;   LPOKE &BF000,&123456,&789ABC   met 56 34 12 en &BF000
0BF0A4                   	;                                  puis BC 9A 78 en &BF003
0BF0A4                   	;
0BF0A4                   	; C'est le pendant de LPEEK, et il comble un manque reel : ces pointeurs de
0BF0A4                   	; trois octets se decomposaient jusqu'ici a la main, cote BASIC --
0BF0A4                   	;   AH=INT (AD/&10000):AM=INT ((AD-AH*&10000)/&100):AL=AD-AH*&10000-AM*&100
0BF0A4                   	;   POKE dest,AL,AM,AH
0BF0A4                   	;
0BF0A4                   	; ⛔ C'EST UNE INSTRUCTION, PAS UNE FONCTION. Le resolveur de la ROM n'est donc
0BF0A4                   	;    pas le meme : 0F58E5h teste le bit 7 et prend l'adresse TELLE QUELLE, la ou
0BF0A4                   	;    0F590Bh teste le bit 6 et ajoute 3. L'entree de repartition porte donc 080h
0BF0A4                   	;    et il n'y a PAS de prefixe de trois octets devant le point d'entree.
0BF0A4                   	;
0BF0A4                   	; ⛔ LA BOUCLE EST CELLE DE BAS_POKE (0F9F27h), Y COMPRIS SA SORTIE.
0BF0A4                   	;    On lit un caractere, on le compare a 02Ch ; si ce n'est pas une virgule, on
0BF0A4                   	;    rend la main -- mais en REMETTANT le caractere par un « dec x ». La ROM le
0BF0A4                   	;    fait par une chute : son « rc » de 0F9F2Fh tombe dans le « dec x » de
0BF0A4                   	;    0F9F30h, partage avec le chemin d'erreur. On copie cette disposition.
0BF0A4                   	;
0BF0A4                   	; ⛔ ET CHAQUE chknum PREND UN CADRE DE 15 OCTETS, QU'IL FAUT RENDRE.
0BF0A4                   	;    LPEEK n'appelle chknum qu'une fois et n'a donc jamais eu a s'en soucier.
0BF0A4                   	;    Ici la boucle en appelle un par valeur : sans le « pmdf +15 » apres chacune,
0BF0A4                   	;    les cadres s'empilent et BP finit par sortir de sa zone. Le compte doit
0BF0A4                   	;    revenir a zero sur TOUS les chemins, erreurs comprises.
0BF0A4                   	;
0BF0A4                   	; ⛔ PORTEE DES VALEURS : 20 BITS, ET C'EST dec2bin QUI L'IMPOSE.
0BF0A4                   	;    Son code (0EFB8Bh) ne convertit que 8+8+4 bits -- constate en ecrivant
0BF0A4                   	;    LPEEK. Une valeur au-dela de 0FFFFFh serait donc tronquee AVANT de nous
0BF0A4                   	;    parvenir, sans que rien ne le signale et sans que nous puissions le
0BF0A4                   	;    detecter apres coup. Sans consequence pour l'usage vise, une adresse de
0BF0A4                   	;    cette machine faisant 20 bits, mais cela doit etre dit.
0BF0A4                   	
