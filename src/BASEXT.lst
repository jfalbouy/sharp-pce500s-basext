0BF18B                   	; --- rendre le reste exactement comme LPEEK rend le sien --------------------
0BF18B                   	; ⛔ LE DECALAGE DE chknum EST DESORMAIS MESURE, ET NON SUPPOSE. Le module a
0BF18B                   	;    laisse BP en RAM avant et apres son premier chknum ; releve sur la machine :
0BF18B                   	;    96h puis 87h, soit QUINZE octets tout rond. Le cadre du resultat est donc
0BF18B                   	;    celui d'un pmdf +15, et sv_a n'a plus a servir de pont -- ce qui le laisse
0BF18B                   	;    porter A, donc mesurable a son tour.
0BF18B                   	; sv_a a rendu A a la boucle : il sert maintenant de pont vers l'autre cadre.
0BF18B DA B5 F6 0B 08    	        mvp     [!sv_a],(BP+8)          ; le reste, le temps de changer de cadre
0BF190 30 D0 EC B9 F6 0B 	        mv      (bp_ram),[!sv_bp1]      ; le cadre du resultat, en ABSOLU
0BF196 CC 00 00          	        mv      (BP+0),000H             ; positif, simple precision
0BF199 D2 01 B5 F6 0B    	        mvp     (BP+1),[!sv_a]
0BF19E 05 6F FB 0E       	        callf   bin2dec                 ; -> nombre BASIC en (bp+0)
0BF1A2 3C                	        popu    x
