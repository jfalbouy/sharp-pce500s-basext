000000                   	; ============================================================================
000000                   	; LPEEK.ASM -- ajoute la FONCTION BASIC  LPEEK <adresse>
000000                   	; ============================================================================
000000                   	;
000000                   	; ⛔ LE NOM NE POUVAIT PAS ETRE "PEEKX", ET L'ESSAI MACHINE L'A MONTRE.
000000                   	;    Le tokeniseur consulte la table de la ROM AVANT la notre. "PEEKX" y est
000000                   	;    donc coupe en PEEK + la variable X, et la ligne devient une erreur de
000000                   	;    syntaxe -- relue ensuite, elle s'affiche litteralement
000000                   	;    "PRINT HEX$ PEEK X &BF100".
000000                   	;
000000                   	;    LA REGLE, valable pour toute extension : un mot-cle ajoute ne doit pas
000000                   	;    COMMENCER par un mot-cle existant, ni etre le debut de l'un d'eux. Cela se
000000                   	;    verifie avant d'ecrire une ligne de code, sur les 168 noms de
000000                   	;    Data/BasicTokens.csv. LPEEK est libre dans les deux sens.
000000                   	;
000000                   	;   LPEEK &BF0B8   rend la valeur de l'adresse 3 octets rangee en &BF0B8,
000000                   	;                  soit l'equivalent de
000000                   	;                  PEEK &BF0B8 + PEEK &BF0B9 * 256 + PEEK &BF0BA * 65536
000000                   	;
000000                   	; Ce n'est pas un CALL : c'est une INSTRUCTION DU LANGAGE, utilisable dans une
000000                   	; expression -- PRINT LPEEK &BF0B8, A = LPEEK X + 1, etc.
000000                   	;
000000                   	;   LOAD M "S1:LPEEK.OBJ" : CALL &BF000      installe
000000                   	;   PRINT HEX$ LPEEK &BF0B8
000000                   	;
000000                   	; ---------------------------------------------------------------------------
000000                   	; COMMENT L'INTERPRETEUR NOUS TROUVE  (tout est lu dans la ROM)
000000                   	; ---------------------------------------------------------------------------
000000                   	;
000000                   	; Deux crochets dans la zone de travail du BASIC, x = (baswrk) = (0D1h) :
000000                   	;
000000                   	;   [x+090h]   la table de mots-cles      (texte -> token)
000000                   	;   [x+093h]   la table de repartition    (token -> routine)
000000                   	;
000000                   	; La ROM y met 0FFFFFh au demarrage (SUB_F93C3) : la sentinelle "rien".
000000                   	;
000000                   	; La repartition se balaie par SUB_F593D (0F593Dh) : entrees de QUATRE octets,
000000                   	; token puis adresse, arret sur un token 000h.
000000                   	;
000000                   	; ⛔ ET LE QUARTET HAUT DU 3e OCTET D'ADRESSE EST UN DRAPEAU. Les deux
000000                   	;    resolveurs de la ROM sont cote a cote et ne different que par le bit :
000000                   	;
000000                   	;      0F58E5h  instruction : test a,080h -> routine = l'adresse telle quelle
000000                   	;      0F590Bh  FONCTION    : test a,040h -> routine = l'adresse + 3
000000                   	;
000000                   	;    PEEKX etant une fonction, on range donc (routine - 3) avec le bit 6 arme.
000000                   	;    Les trois octets sautes n'ont aucun sens : dans la ROM, ce sont ceux de la
000000                   	;    routine precedente. On y met trois zeros.
000000                   	;
000000                   	; ---------------------------------------------------------------------------
000000                   	; LE CORPS -- calque sur BAS_PEEK (0F9F44h), avec les entrees LOINTAINES
000000                   	; ---------------------------------------------------------------------------
000000                   	;
000000                   	; Une extension vit en page 0B, les services en 0E et 0F. Un service termine
000000                   	; par RET ne se laisse PAS appeler d'ici : son retour depile 2 octets et reste
000000                   	; dans SA page. Il faut donc, pour chaque service, l'entree qui finit par RETF.
000000                   	;
000000                   	;   BAS_PEEK fait            ici on fait              parce que
000000                   	;   -----------------------  -----------------------  ------------------------
000000                   	;   call SUB_F5F9C           callf 0EFBF3h            F5F9C finit par RET ;
000000                   	;                            puis callf 0EFAD4h       EFBF3 et EFAD4 par RETF.
000000                   	;                                                     F5F9C n'etait que
000000                   	;                                                     "callf EFBF3 + call
000000                   	;                                                     F5C9A", et F5C9A n'etait
000000                   	;                                                     que "callf EFAD4 + mv y".
000000                   	;   callf SUB_EFB6F          callf 0EFB6Fh            deja lointaine
000000                   	;
000000                   	; 0EFAD4h et 0EFB6Fh sont les commandes 07Eh et 07Fh du device 9 -- dec2bin et
000000                   	; bin2dec. Le travail sur la bibliotheque mathematique sert directement ici.
000000                   	;
000000                   	; ⛔ LE CADRE BP -- ET J'AI D'ABORD MAL LU SUB_F5C9A.
000000                   	;
000000                   	;    Elle se termine par "jr LOC_F5C6F", que je n'avais pas suivi. Or LOC_F5C6F
000000                   	;    fait "pmdf (bp_ram),00Fh" : BP + 15. Le compte, entree a sortie :
000000                   	;
000000                   	;      entree                          BP = B
000000                   	;      callf chknum                    BP = B-15   <- le cadre de la valeur
000000                   	;      SUB_F5C9A finit par +15         BP = B
000000                   	;      BAS_PEEK fait -15               BP = B-15   <- ou il ecrit son resultat
000000                   	;
000000                   	;    Ici on n'appelle pas F5C9A, donc on n'a PAS le +15 : apres chknum, BP vaut
000000                   	;    deja B-15, c'est-a-dire exactement le bon cadre. Il ne faut donc AUCUN
000000                   	;    pmdf sur le chemin de succes. La premiere version gardait le -15 de
000000                   	;    BAS_PEEK sans son +15 : elle ecrivait en B-30.
000000                   	;
000000                   	;    Sur le chemin d'ERREUR, en revanche, il faut le +15 : F5C9A le fait dans
000000                   	;    tous les cas, y compris son erreur 33 (LOC_F5C74 saute a LOC_F5C6F).
000000                   	;
000000                   	; ⛔ ET ON ECRIT (BP+n), PAS (000H). Sous pre_on, "(000H)" designe l'adresse
000000                   	;    DIRECTE 0 ; le mode (BP+n) est celui qui n'emet PAS d'octet PRE. Le
000000                   	;    controle se fait dans l'OBJET : sur ces lignes, BAS_PEEK ne porte aucun
000000                   	;    PRE (E0 05 01, CC 00 00, CD 02 00 00). Une premiere version de ce fichier
000000                   	;    portait "30 80 00" -- un PRE, donc l'adresse directe : la fonction lisait
000000                   	;    la RAM interne 0 au lieu du cadre de l'argument.
000000                   	;
000000                   	;       xasm2026-4 LPEEK.ASM -O -L -S -B -K
000000                   	; ============================================================================
000000                   	
000000                   	        include pce500.inc
000000                   	basptr: equ 0D1H ; POINTEUR (3 octets) vers la zone de travail de l'interpreteur BASIC. A NE PAS CONFONDRE avec baswrk = 0BFD0Eh, qui est la zone elle-meme : ce nom-la vient du listing de E. Kako (register.lst, 1990) et sert de verite terrain. Les crochets d'extension du BASIC sont en [(basptr)+090h] et [(basptr)+093h]
000000                   	
000000                   	; --- les entrees LOINTAINES de la ROM (toutes terminees par RETF) -----------
000000                   	chknum:   equ   0EFBF3H    ; evalue l'expression numerique, verifie le type
000000                   	dec2bin:  equ   0EFAD4H    ; le nombre -> entier 24 bits en (bp+1)..(bp+3)
000000                   	bin2dec:  equ   0EFB6FH    ; l'entier de (bp+0)..(bp+3) -> nombre BASIC
000000                   	
000000                   	token:    equ   007H       ; libre dans la table de la ROM (BASCOM occupe 04-06)
000000                   	
000000                   	; ⛔ NE PAS ECRIRE « baswrk » ICI. C'est la ZONE de travail, en memoire EXTERNE
000000                   	;    (0BFD0Eh) -- nom repris du listing de E. Kako, ou il est declare
000000                   	;    « baswrk: equ 0bfd0eh ». Le pointeur qu'il nous faut est en RAM INTERNE, a
000000                   	;    0D1h, que le carnet nommait « baswrk » lui aussi jusqu'au 2026-09-03 et
000000                   	;    nomme desormais « basptr ». Depuis, pce500.inc EXPOSE les deux et le
000000                   	;    generateur REFUSE une collision de noms : il n'y a plus d'equ local ici.
000000                   	;    Et « mv x,(baswrk) » ne proteste pas : l'operande interne fait 8 bits, XASM
000000                   	;    TRONQUE 0BFD0Eh en 0Eh. Le code ecrivait donc les crochets en
000000                   	;    [(00Eh)+090h], et la table d'extension n'a jamais ete installee.
000000                   	;    Verifiable dans l'objet : on doit lire « 30 84 D1 », pas « 30 84 0E ».
000000                   	err_syn:  equ   00AH       ; erreur BASIC 10, Syntax error
000000                   	
0BF000                   	        org     0BF000H
0BF000                   	        pre_on
0BF000                   	
0BF000                   	; ============================================================================
0BF000                   	; L'INSTALLATION -- c'est ici que mene CALL &BF000
0BF000                   	; ============================================================================
0BF000                   	start:
0BF000 2C                	        pushu   x               ; X porte le point de reprise de l'interpreteur
0BF001 2B                	        pushu   i
0BF002 30 84 D1          	        mv      x,(basptr)
0BF005 95 84 90          	        mv      y,[x+090H]      ; l'ancienne table de mots-cles
0BF008 AD 37 F0 0B       	        mv      [old_kw],y      ;   sauvee : de quoi desinstaller
0BF00C 95 84 93          	        mv      y,[x+093H]      ; l'ancienne table de repartition
0BF00F AD 3A F0 0B       	        mv      [old_disp],y
0BF013 0D 2A F0 0B       	        mv      y,kw_table
0BF017 B5 84 90          	        mv      [x+090H],y
0BF01A 0D 32 F0 0B       	        mv      y,disp_table
0BF01E B5 84 93          	        mv      [x+093H],y
0BF021 3B                	        popu    i
0BF022 3C                	        popu    x
0BF023 9F                	        rc                      ; carry CLAIR : retour propre a BASIC
0BF024 07                	        retf
0BF025                   	
0BF025                   	; ============================================================================
0BF025                   	; LA FONCTION -- l'interpreteur y saute a lpeek_m3 + 3
0BF025                   	; ============================================================================
0BF025                   	lpeek_m3:
0BF025 00 00 00          	        db      0,0,0           ; les trois octets que le resolveur saute
0BF028                   	
0BF028                   	lpeek:
0BF028                   	; ---------------------------------------------------------------------------
0BF028                   	; SONDE 3 -- declaree INSTRUCTION (bit 7), et ne fait rien.
0BF028                   	;
0BF028                   	; « PRINT LSEPT (5) » a rendu « Array specified without DIM » : en position
0BF028                   	; d'EXPRESSION, l'interpreteur voit notre mot-cle comme un nom de VARIABLE.
0BF028                   	; Le token n'y est donc pas resolu comme fonction.
0BF028                   	;
0BF028                   	; Cette sonde le declare en instruction -- bit 7 au lieu du bit 6, et la
0BF028                   	; routine pointee DIRECTEMENT (pas d'adresse-3). Elle ne fait rien du tout.
0BF028                   	;
0BF028                   	;   « LSEPT » seul ne dit rien   -> toute la chaine d'extension fonctionne,
0BF028                   	;                                   et SEUL le bit fonction reste a percer.
0BF028                   	;   « LSEPT » erreur             -> le probleme est en amont, et il ne sert a
0BF028                   	;                                   rien de chercher du cote des fonctions.
0BF028                   	; ---------------------------------------------------------------------------
0BF028 9F                	        rc                      ; pas d'erreur
0BF029 07                	        retf
0BF02A                   	
0BF02A                   	; ============================================================================
0BF02A                   	; LES DEUX TABLES
0BF02A                   	; ============================================================================
0BF02A                   	kw_table:
0BF02A 05 4C 53 45 50 54 	        db      5,'LSEPT',token
0BF030 07                	
0BF031 00                	        db      0                       ; fin de table
0BF032                   	
0BF032                   	disp_table:
0BF032                   	; token, puis l'adresse de la routine sur 3 octets, BIT 7 arme = "instruction".
0BF032                   	; Pour une FONCTION ce serait (routine - 3) avec le bit 6 : 040h au lieu de 080h.
0BF032                   	; L'entree obtenue, « 07 28 F0 8B », a exactement la forme de celles de BASCOM
0BF032                   	; (« 04 BB DF 8B ») -- meme quartet 8.
0BF032 07                	        db      token
0BF033 28                	        db      lpeek
0BF034 F0                	        db      lpeek/256
0BF035 8B                	        db      lpeek/65536+080H
0BF036 00                	        db      0                       ; fin de table
0BF037                   	
0BF037                   	; ============================================================================
0BF037                   	; LES CROCHETS D'ORIGINE, pour desinstaller
0BF037                   	; ============================================================================
0BF037 00 00 00          	old_kw:   db    0,0,0
0BF03A 00 00 00          	old_disp: db    0,0,0
0BF03D                   	
0BF03D                   	        end

